<Project>
	<PropertyGroup>
		<AppName>DataOrganizer</AppName>
		<AppDisplayName>Data Organizer</AppDisplayName>
		<AppIconPath>..\$(AppName).UI\Assets\Logo.ico</AppIconPath>
		<AppVersion>0.3.0</AppVersion>
		<AppTargetFramework>net11.0</AppTargetFramework>
		<Manufacturer>Alexey Fala</Manufacturer>
		<License>Apache-2.0</License>
		<_DebugSuffix Condition="'$(Configuration)' != 'Release'">-debug</_DebugSuffix>
		<OutputBaseName>$(AppName)-$(AppVersion)</OutputBaseName>
		<MsiOutputName>$(OutputBaseName)-win-$(Platform)$(_DebugSuffix)</MsiOutputName>
		<SetupCulture>en-us</SetupCulture>
		<SetupProductName>$(AppDisplayName)</SetupProductName>
		<SetupProductName Condition="'$(Configuration)' != 'Release'">$(AppDisplayName) (Debug)</SetupProductName>
	</PropertyGroup>

	<!-- C# settings and the assembly and product version every project shares; a project states only where it differs. -->
	<PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
		<TargetFramework>$(AppTargetFramework)</TargetFramework>
		<Nullable>enable</Nullable>
		<WarningsAsErrors>nullable</WarningsAsErrors>
		<Version>$(AppVersion)</Version>
		<!-- Keeps the commit hash out of the product version. -->
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
	</PropertyGroup>

	<!--
		Writes the XML documentation, which the build needs to report an orphaned using (IDE0005)
		and a public member without a summary; the published application leaves it out.
	-->
	<PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PublishDocumentationFiles>false</PublishDocumentationFiles>
	</PropertyGroup>

	<!--
		Runs the IDE code-style analyzers during the build, so a naming rule from
		.editorconfig is reported by the compiler and not only inside the IDE.
	-->
	<PropertyGroup>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
	</PropertyGroup>

	<!--
		Runs the .NET analyzers in the Recommended mode, which reports more of their rules as warnings;
		.editorconfig switches off a rule that does not fit.
	-->
	<PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
		<AnalysisMode>Recommended</AnalysisMode>
	</PropertyGroup>

	<!--
		Assembly metadata shown on the file's Details tab in Windows Explorer
		(Authors and PackageLicenseExpression apply to NuGet packages only).
	-->
	<PropertyGroup>
		<Product>$(AppDisplayName)</Product>
		<AssemblyTitle>$(AppDisplayName)</AssemblyTitle>
		<Authors>$(Manufacturer)</Authors>
		<Company>$(Manufacturer)</Company>
		<Copyright>Copyright (c) 2026 $(Manufacturer)</Copyright>
		<PackageLicenseExpression>$(License)</PackageLicenseExpression>
	</PropertyGroup>

	<!--
		Roslynator analyzers for every C# project; .editorconfig sets their levels. They run only at
		build time, so the published application and its third-party notices leave them out.
	-->
	<ItemGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
		<PackageReference Include="Roslynator.Analyzers">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>
</Project>
