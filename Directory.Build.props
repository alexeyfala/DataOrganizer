<Project>
	<!--
		Runs the IDE code-style analyzers during the build, so a naming rule from
		.editorconfig is reported by the compiler and not only inside the IDE.
	-->
	<PropertyGroup>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
	</PropertyGroup>

	<!--
		Application code reaches files and processes only through their abstractions:
		RS0030 stops a direct call listed in BannedSymbols.txt. Tests, their support
		and the installer's custom actions stay outside the ban.
	-->
	<PropertyGroup>
		<IsOutsideApiBan Condition="$(MSBuildProjectName.EndsWith('Tests')) or '$(MSBuildProjectName)' == 'TestSupport' or '$(MSBuildProjectName)' == 'Setup.CustomActions'">true</IsOutsideApiBan>
	</PropertyGroup>

	<ItemGroup Condition="'$(MSBuildProjectExtension)' == '.csproj' and '$(IsOutsideApiBan)' != 'true'">
		<PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<!-- Shown once among the solution items, not as a link in every project. -->
		<AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" Visible="false" />
	</ItemGroup>

	<PropertyGroup>
		<AppName>DataOrganizer</AppName>
		<AppDisplayName>Data Organizer</AppDisplayName>
		<AppIconPath>..\$(AppName)\Assets\Logo.ico</AppIconPath>
		<AppVersion>0.3.0</AppVersion>
		<Manufacturer>Alexey Fala</Manufacturer>
		<License>Apache-2.0</License>
		<_DebugSuffix Condition="'$(Configuration)' != 'Release'">-debug</_DebugSuffix>
		<OutputBaseName>$(AppName)-$(AppVersion)</OutputBaseName>
		<MsiOutputName>$(OutputBaseName)-win-$(Platform)$(_DebugSuffix)</MsiOutputName>
		<SetupCulture>en-us</SetupCulture>
	</PropertyGroup>

	<!--
		Assembly metadata shown on the file's Details tab in Windows Explorer
		(Authors and PackageLicenseExpression apply to NuGet packages only).
	-->
	<PropertyGroup>
		<Product>$(AppDisplayName)</Product>
		<AssemblyTitle>$(AppDisplayName)</AssemblyTitle>
		<Authors>$(Manufacturer)</Authors>
		<Company>$(Manufacturer)</Company>
		<Copyright>Copyright (c) 2026 $(Manufacturer)</Copyright>
		<PackageLicenseExpression>$(License)</PackageLicenseExpression>
	</PropertyGroup>
</Project>
