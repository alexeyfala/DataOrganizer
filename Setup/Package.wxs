<!--
	Binary - https://docs.firegiant.com/wix/schema/wxs/binary
	ComponentGroupRef - https://docs.firegiant.com/wix/schema/wxs/componentgroup
	Custom - https://docs.firegiant.com/wix/schema/wxs/custom
	CustomAction - https://docs.firegiant.com/wix/schema/wxs/customaction
	Feature - https://docs.firegiant.com/wix/schema/wxs/feature
	Icon - https://docs.firegiant.com/wix/schema/wxs/icon
	InstallExecuteSequence - https://docs.firegiant.com/wix/schema/wxs/installexecutesequence
	InstallUISequence - https://docs.firegiant.com/wix/schema/wxs/installuisequence
	MajorUpgrade - https://docs.firegiant.com/wix/schema/wxs/majorupgrade
	Media - https://docs.firegiant.com/wix/schema/wxs/media
	Package - https://docs.firegiant.com/wix/schema/wxs/package
	Property - https://docs.firegiant.com/wix/schema/wxs/property
	Publish - https://docs.firegiant.com/wix/schema/wxs/publish
	UI - https://docs.firegiant.com/wix/schema/wxs/ui
	UIRef - https://docs.firegiant.com/wix/schema/wxs/uiref
	Wix - https://docs.firegiant.com/wix/schema/wxs/wix
	WixUI - https://docs.firegiant.com/wix/schema/ui/wixui
	WixVariable - https://docs.firegiant.com/wix/schema/wxs/wixvariable
-->

<!--
	Dialogs:
	https://docs.firegiant.com/wix/tools/wixext/wixui

	Launch after setup:
	https://docs.firegiant.com/wix3/howtos/ui_and_localization/run_program_after_install
-->

<?include Predefines.wxi ?>

<Wix
	xmlns="http://wixtoolset.org/schemas/v4/wxs"
	xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
	<Package
		Manufacturer="$(var.Manufacturer)"
		Name="$(var.FullName)"
		UpgradeCode="$(var.UpgradeCode)"
		Version="$(var.AppVersion)">

		<!--
			This makes sure the .cab file is embedded in the .msi file;
			otherwise, the .cab file is external and must be moved around with
			the .msi file.
		-->
		<Media
			Cabinet="App.cab"
			EmbedCab="yes"
			Id="1" />

		<!--
			Summary Information Stream: metadata shown on the file's
			Details tab in Windows Explorer.
		-->
		<SummaryInformation
			Comments="$(var.AppDisplayName) installer. Copyright (c) 2026 $(var.Manufacturer). Licensed under $(var.License)."
			Description="$(var.AppDisplayName) $(var.AppVersion) Setup"
			Keywords="Installer, MSI, $(var.AppDisplayName)" />

		<!--
			A rebuild of the same version replaces the installed one instead of installing beside it.
		-->
		<MajorUpgrade
			AllowSameVersionUpgrades="yes"
			DowngradeErrorMessage="!(loc.DowngradeError)" />

		<!--
			https://docs.firegiant.com/wix3/wixui/dialog_reference/wixui_advanced
		-->
		<ui:WixUI Id="WixUI_Advanced" />

		<!-- Add a reference to all the messages produced by the installer. -->
		<UIRef Id="WixUI_ErrorProgressText" />

		<!--
			Advanced dialog requires this to be defined.  It is used as the
			name of the Program Files folder and LocalAppData folder for the
			application.
		-->
		<Property
			Id="ApplicationFolderName"
			Value="$(var.AppName)" />

		<Property
			Id="WixAppFolder"
			Value="WixPerMachineFolder" />

		<!--
			WixUI_Advanced defaults per-user installs to "[LocalAppDataFolder]Apps\[ApplicationFolderName]".
			Use the per-user Programs folder of Windows (FOLDERID_UserProgramFiles) instead.
		-->
		<CustomAction
			Execute="immediate"
			Id="WixSetDefaultPerUserFolderPrograms"
			Property="WixPerUserFolder"
			Value="[LocalAppDataFolder]Programs\[ApplicationFolderName]" />

		<InstallExecuteSequence>
			<Custom
				Action="WixSetDefaultPerUserFolderPrograms"
				Before="WixSetPerUserFolder" />
		</InstallExecuteSequence>

		<InstallUISequence>
			<Custom
				Action="WixSetDefaultPerUserFolderPrograms"
				Before="WixSetPerUserFolder" />
		</InstallUISequence>

		<!--
			For a per-user choice WixUI_Advanced only sets the APPLICATIONFOLDER property. SetTargetPath moves
			the folder itself too, as InstallDirDlg does for all users, so [#AppExe] points into it.
		-->
		<UI>
			<Publish
				Condition="WixAppFolder = &quot;WixPerUserFolder&quot;"
				Control="Next"
				Dialog="InstallScopeDlg"
				Event="SetTargetPath"
				Order="5"
				Value="APPLICATIONFOLDER" />
		</UI>

		<!--
			The search of the dialogs for installed versions runs before the scope is chosen, so it sees only
			installs for all users, and Windows Installer never repeats it. A per-user choice repeats it here.
		-->
		<Binary
			Id="SetupCustomActions"
			SourceFile="$(var.Setup.CustomActions.TargetDir)$(var.Setup.CustomActions.TargetName).CA.dll" />

		<CustomAction
			BinaryRef="SetupCustomActions"
			DllEntry="FindPerUserRelatedProducts"
			Execute="immediate"
			Id="FindPerUserRelatedProducts"
			Return="check" />

		<!--
			The Install button without the UAC shield ends a per-user choice. It hands the choice to
			Windows Installer 5.0 as the per-user context of a dual-purpose package, which needs no UAC.
		-->
		<UI>
			<Publish
				Condition="NOT Installed"
				Control="InstallNoShield"
				Dialog="FeaturesDlg"
				Event="DoAction"
				Order="1"
				Value="FindPerUserRelatedProducts" />

			<Publish
				Condition="NOT Installed"
				Control="InstallNoShield"
				Dialog="FeaturesDlg"
				Order="1"
				Property="MSIINSTALLPERUSER"
				Value="1" />

			<Publish
				Condition="NOT Installed"
				Control="InstallNoShield"
				Dialog="FeaturesDlg"
				Order="1"
				Property="ALLUSERS"
				Value="2" />
		</UI>

		<!--
			The optional check box of the exit dialog starts the application, unchecked by default.
			Explorer starts it, so it gets the rights of the signed-in user even from an elevated installer.
		-->
		<WixVariable
			Id="AppDisplayName"
			Value="$(var.AppDisplayName)" />

		<Property
			Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT"
			Value="!(loc.LaunchApplication)" />

		<CustomAction
			Directory="WindowsFolder"
			ExeCommand="&quot;[WindowsFolder]explorer.exe&quot; &quot;[#AppExe]&quot;"
			Execute="immediate"
			Id="LaunchApplication"
			Impersonate="yes"
			Return="asyncNoWait" />

		<UI>
			<Publish
				Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed"
				Control="Finish"
				Dialog="ExitDialog"
				Event="DoAction"
				Value="LaunchApplication" />
		</UI>

		<Property
			Id="ARPNOREPAIR"
			Value="1" />

		<Property
			Id="ARPNOMODIFY"
			Value="1" />

		<!--
			A license rtf file.
		-->
		<WixVariable
			Id="WixUILicenseRtf"
			Value="LICENSE.rtf" />

		<!--
			Add Icon and ARPPRODUCTICON (the installer icon). 
			Note: ARPPRODUCTICON = Add/Remove Program Product Icon
			This icon is visible in the Windows Apps and Features list.
		-->
		<Icon
			Id="AppIcon"
			SourceFile="$(var.AppIconPath)" />

		<Property
			Id="ARPPRODUCTICON"
			Value="AppIcon" />

		<!--
			The main feature cannot be optional (AllowAbsent="no") and is always installed.
		-->
		<Feature
			AllowAbsent="no"
			AllowAdvertise="no"
			ConfigurableDirectory="APPLICATIONFOLDER"
			Description="The core elements that must be installed"
			Id="Main"
			Title="$(var.AppDisplayName) Application">
			<ComponentGroupRef Id="Components" />
		</Feature>

		<!--
			Start at sign-in, off by default: its level is above the default INSTALLLEVEL of 1.
		-->
		<Feature
			AllowAdvertise="no"
			Description="!(loc.AutostartFeatureDescription)"
			Id="Autostart"
			Level="2"
			Title="!(loc.AutostartFeatureTitle)">
			<ComponentGroupRef Id="Autostart" />
		</Feature>
	</Package>
</Wix>
