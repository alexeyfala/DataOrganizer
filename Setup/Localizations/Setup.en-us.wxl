<!--
	WixLocalization - https://docs.firegiant.com/wix/schema/wxl/wixlocalization
-->

<WixLocalization
	Culture="en-us"
	xmlns="http://wixtoolset.org/schemas/v4/wxl">
	<String
		Id="AutostartFeatureDescription"
		Value="Adds !(wix.AppDisplayName) to the startup apps of Windows." />

	<String
		Id="AutostartFeatureTitle"
		Value="Start !(wix.AppDisplayName) when Windows starts" />

	<String
		Id="DowngradeError"
		Value="A newer version of !(wix.AppDisplayName) is already installed." />

	<String
		Id="InstalledForAllUsersError"
		Value="!(wix.AppDisplayName) is already installed for all users. It must be removed before installing for the current user only." />

	<String
		Id="InstalledForCurrentUserError"
		Value="!(wix.AppDisplayName) is already installed for the current user. It must be removed before installing for all users." />

	<String
		Id="LaunchApplication"
		Value="Launch !(wix.AppDisplayName)" />
</WixLocalization>
