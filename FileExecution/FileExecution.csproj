<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<WarningsAsErrors>nullable</WarningsAsErrors>
		<FileVersion>$(AppVersion)</FileVersion>
		<AssemblyVersion>$(AppVersion)</AssemblyVersion>
		<!-- Required by [LibraryImport] source generator (writes unsafe interop stubs). -->
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="System.Drawing.Common" Version="10.0.14" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\AppInstance\AppInstance.csproj" />
		<ProjectReference Include="..\DialogContracts\DialogContracts.csproj" />
		<ProjectReference Include="..\FileContents\FileContents.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="FileExecution.UnitTests" />
	</ItemGroup>

</Project>
