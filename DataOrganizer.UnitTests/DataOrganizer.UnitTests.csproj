<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<WarningsAsErrors>nullable</WarningsAsErrors>
		<IsPackable>false</IsPackable>
		<FileVersion>$(AppVersion)</FileVersion>
		<AssemblyVersion>$(AppVersion)</AssemblyVersion>
		<!-- Required by [LibraryImport] source generator (writes unsafe interop stubs). -->
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Autofac.Extras.Moq" />
		<PackageReference Include="Avalonia.Headless.NUnit" />
		<PackageReference Include="AwesomeAssertions" />
		<PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
		<PackageReference Include="coverlet.collector">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="NSubstitute" />
		<PackageReference Include="NUnit.Analyzers">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="NUnit3TestAdapter" />
		<PackageReference Include="SharpHook.Testing" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\tests\DataOrganizer.TestSupport\DataOrganizer.TestSupport.csproj" />
		<ProjectReference Include="..\DataOrganizer\DataOrganizer.csproj" />
	</ItemGroup>

	<!-- Test helpers kept in the test projects of their layers and compiled here from the same files. -->
	<ItemGroup>
		<Compile Include="..\tests\DataOrganizer.SystemIntegration.UnitTests\Clipboard\Factories\ClipboardEntryFactory.cs" Link="Factories\ClipboardEntryFactory.cs" />
		<Compile Include="..\tests\DataOrganizer.SystemIntegration.UnitTests\GlobalHotkeys\Factories\HotkeyFactory.cs" Link="Factories\HotkeyFactory.cs" />
		<Compile Include="..\tests\DataOrganizer.Hierarchy.UnitTests\Factories\ItemDtoFactory.cs" Link="Factories\ItemDtoFactory.cs" />
		<Compile Include="..\tests\DataOrganizer.Infrastructure.UnitTests\Settings\Factories\SettingsFactory.cs" Link="Factories\SettingsFactory.cs" />
		<Compile Include="..\tests\DataOrganizer.Documents.UnitTests\TextProcessing\Fakes\FixedFoldingStrategy.cs" Link="Fakes\FixedFoldingStrategy.cs" />
		<Compile Include="..\tests\DataOrganizer.Shared.UnitTests\Threading\Fakes\InlineDispatcherAccessor.cs" Link="Fakes\InlineDispatcherAccessor.cs" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="NUnit.Framework" />
	</ItemGroup>

</Project>
