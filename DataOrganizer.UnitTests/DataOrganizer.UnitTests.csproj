<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<WarningsAsErrors>nullable</WarningsAsErrors>
		<IsPackable>false</IsPackable>
		<FileVersion>$(AppVersion)</FileVersion>
		<AssemblyVersion>$(AppVersion)</AssemblyVersion>
		<!-- Required by [LibraryImport] source generator (writes unsafe interop stubs). -->
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Autofac.Extras.Moq" Version="8.0.1" />
		<PackageReference Include="Avalonia.Headless.NUnit" Version="12.1.3" />
		<PackageReference Include="AwesomeAssertions" Version="9.6.0" />
		<PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
		<PackageReference Include="coverlet.collector" Version="10.1.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
		<PackageReference Include="NSubstitute" Version="6.2.0" />
		<PackageReference Include="NUnit" Version="5.0.0" />
		<PackageReference Include="NUnit.Analyzers" Version="4.15.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
		<PackageReference Include="SharpHook.Testing" Version="8.0.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\TestSupport\TestSupport.csproj" />
		<ProjectReference Include="..\DataOrganizer\DataOrganizer.csproj" />
	</ItemGroup>

	<!-- Test helpers kept in the test projects of their layers and compiled here from the same files. -->
	<ItemGroup>
		<Compile Include="..\DataProtection.UnitTests\Factories\Argon2SettingsFactory.cs" Link="Factories\Argon2SettingsFactory.cs" />
		<Compile Include="..\DataProtection.UnitTests\Factories\SecretFactory.cs" Link="Factories\SecretFactory.cs" />
		<Compile Include="..\GlobalHotkeys.UnitTests\Factories\HotkeyFactory.cs" Link="Factories\HotkeyFactory.cs" />
		<Compile Include="..\Hierarchy.UnitTests\Factories\ItemDtoFactory.cs" Link="Factories\ItemDtoFactory.cs" />
		<Compile Include="..\Settings.UnitTests\Factories\SettingsFactory.cs" Link="Factories\SettingsFactory.cs" />
		<Compile Include="..\TextProcessing.UnitTests\Fakes\FixedFoldingStrategy.cs" Link="Fakes\FixedFoldingStrategy.cs" />
		<Compile Include="..\Threading.UnitTests\Fakes\InlineDispatcherAccessor.cs" Link="Fakes\InlineDispatcherAccessor.cs" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="NUnit.Framework" />
	</ItemGroup>

</Project>
