<Window
	x:Class="DataOrganizer.Windows.ToastWindow"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:windows="using:DataOrganizer.ViewModels.Windows"
	MinWidth="400.0"
	MaxWidth="800.0"
	x:DataType="windows:ToastViewModel"
	Background="Transparent"
	CanResize="False"
	Focusable="False"
	IsTabStop="False"
	ShowActivated="False"
	ShowInTaskbar="False"
	SizeToContent="WidthAndHeight"
	Topmost="True"
	WindowDecorations="None"
	mc:Ignorable="d">

	<Border
		Background="{StaticResource MaterialPaperBrush}"
		BorderBrush="{StaticResource MaterialPrimaryMidBrush}"
		BorderThickness="{StaticResource ChromelessWindowBorderThickness}"
		CornerRadius="8.0">
		<Grid
			ColumnDefinitions="Auto,*"
			RowDefinitions="Auto,*">
			<Image
				Grid.Row="0"
				Grid.Column="0"
				Margin="10.0"
				Classes="AppImageStyle" />

			<TextBlock
				Grid.Row="0"
				Grid.Column="1"
				VerticalAlignment="Center"
				FontWeight="SemiBold"
				Text="{Binding Title, Mode=OneWay}" />

			<!--
				The default text menu is a popup: opening it takes the pointer off the toast, and the toast closes with the menu still on it.
			-->
			<SelectableTextBlock
				Grid.Row="1"
				Grid.Column="0"
				Grid.ColumnSpan="2"
				Margin="32.0,0.0,32.0,16.0"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				ContextFlyout="{x:Null}"
				FontSize="16.0"
				Text="{Binding Message, Mode=OneWay}"
				TextAlignment="Left"
				TextTrimming="CharacterEllipsis" />
		</Grid>
	</Border>
</Window>
