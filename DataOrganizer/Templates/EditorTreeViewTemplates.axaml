<ResourceDictionary
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:converters="using:DataOrganizer.Converters"
	xmlns:entities="using:DataOrganizer.Dto.Entities"
	xmlns:input="using:DataOrganizer.Behaviors.Input"
	xmlns:markup="using:DataOrganizer.Markup"
	xmlns:materialIcons="using:Material.Icons.Avalonia"
	xmlns:notes="using:DataOrganizer.Interfaces.Notes"
	xmlns:text="using:DataOrganizer.Behaviors.Text"
	xmlns:views="using:DataOrganizer.Views">

	<!-- FolderInTreeViewTemplate -->
	<TreeDataTemplate
		x:Key="FolderInTreeViewTemplate"
		x:DataType="entities:FolderDto"
		ItemsSource="{ReflectionBinding Children,
		                                Mode=OneTime}">
		<Grid
			Background="Transparent"
			ColumnDefinitions="Auto,*,Auto">

			<Grid.Styles>
				<Style Selector="FlyoutPresenter">
					<Setter Property="Background" Value="{StaticResource MaterialCardBackgroundBrush}" />
				</Style>
			</Grid.Styles>

			<Interaction.Behaviors>
				<input:LazyContextFlyoutBehavior ContentTemplate="{StaticResource FolderInTreeViewContextMenuTemplate}" />
			</Interaction.Behaviors>

			<Grid Grid.Column="0">
				<materialIcons:MaterialIcon Classes="FolderIconStyle" />

				<TextBlock
					HorizontalAlignment="Right"
					VerticalAlignment="Bottom"
					Text="{Binding Children.Count, Mode=OneWay}" />
			</Grid>

			<TextBlock
				Grid.Column="1"
				Classes="DtoNameTextBlockStyle"
				Text="{Binding Name, Mode=OneWay}">
				<Interaction.Behaviors>
					<text:TextBlockAutoToolTipBehavior />
				</Interaction.Behaviors>
			</TextBlock>

			<views:IconsBlock
				Grid.Column="2"
				EncryptionStatus="{Binding EncryptionStatus, Mode=OneWay}"
				HasNote="{Binding Note, Mode=OneWay, Converter={x:Static ObjectConverters.IsNotNull}}"
				NoteItem="{Binding Mode=OneWay}"
				NoteName="{Binding Name, Mode=OneWay}"
				NoteReader="{markup:Resolve {x:Type notes:INoteReader}}" />
		</Grid>
	</TreeDataTemplate>

	<!-- FileInTreeViewTemplate -->
	<DataTemplate
		x:Key="FileInTreeViewTemplate"
		x:DataType="entities:FileDto">
		<Grid
			Background="Transparent"
			ColumnDefinitions="Auto,*,Auto">
			<Interaction.Behaviors>
				<input:LazyContextFlyoutBehavior ContentTemplate="{StaticResource FileInTreeViewContextMenuTemplate}" ShowOnDoubleTap="True" />
			</Interaction.Behaviors>

			<Grid.Styles>
				<Style Selector="FlyoutPresenter">
					<Setter Property="Background" Value="{StaticResource MaterialCardBackgroundBrush}" />
				</Style>
			</Grid.Styles>

			<materialIcons:MaterialIcon
				Grid.Column="0"
				Width="{StaticResource EntityKindIconSize}"
				Height="{StaticResource EntityKindIconSize}"
				Foreground="{StaticResource FileBrush}"
				Kind="{Binding Kind, Mode=OneWay, Converter={x:Static converters:AppConverters.EntityKindToIconKind}}" />

			<TextBlock
				Grid.Column="1"
				Classes="DtoNameTextBlockStyle"
				Text="{Binding Name, Mode=OneWay}">
				<Interaction.Behaviors>
					<text:TextBlockAutoToolTipBehavior />
				</Interaction.Behaviors>
			</TextBlock>

			<views:IconsBlock
				Grid.Column="2"
				EncryptionStatus="{Binding EncryptionStatus, Mode=OneWay}"
				HasNote="{Binding Note, Mode=OneWay, Converter={x:Static ObjectConverters.IsNotNull}}"
				IsEditing="{Binding IsEditing, Mode=OneWay}"
				IsExecuting="{Binding IsExecuting, Mode=OneWay}"
				IsFavorite="{Binding IsFavorite, Mode=OneWay}"
				NoteItem="{Binding Mode=OneWay}"
				NoteName="{Binding Name, Mode=OneWay}"
				NoteReader="{markup:Resolve {x:Type notes:INoteReader}}">
				<views:IconsBlock.HotkeysToolTip>
					<MultiBinding
						Converter="{x:Static converters:AppConverters.HotkeysToToolTip}"
						Mode="OneWay">
						<Binding
							Mode="OneWay"
							Path="Hotkeys" />

						<!-- The hotkeys change inside the collection, so its count makes the tip follow them. -->
						<Binding
							Mode="OneWay"
							Path="Hotkeys.Count" />
					</MultiBinding>
				</views:IconsBlock.HotkeysToolTip>
			</views:IconsBlock>
		</Grid>
	</DataTemplate>
</ResourceDictionary>
