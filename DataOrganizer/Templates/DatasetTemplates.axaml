<ResourceDictionary
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="using:DataOrganizer.Controls"
	xmlns:converters="using:DataOrganizer.Converters"
	xmlns:dataset="using:DataOrganizer.Models.Dataset"
	xmlns:dragAndDrop="using:DataOrganizer.Behaviors.DragAndDrop"
	xmlns:input="using:DataOrganizer.Behaviors.Input"
	xmlns:materialIcons="using:Material.Icons.Avalonia"
	xmlns:selectors="using:DataOrganizer.Templates.Selectors"
	xmlns:styling="using:DataOrganizer.Behaviors.Styling"
	xmlns:views="using:DataOrganizer.Views"
	xmlns:vm="using:DataOrganizer.ViewModels">

	<Thickness x:Key="RecordPadding">4.0</Thickness>

	<!--  KeyValueRecordTemplate  -->
	<DataTemplate x:Key="KeyValueRecordTemplate" x:DataType="dataset:KeyValueRecord">
		<Grid Classes="PointerOverBackgroundStyle" ColumnDefinitions="Auto,*">

			<Grid.Styles>
				<Style Selector="FlyoutPresenter">
					<Setter Property="Background" Value="{StaticResource MaterialCardBackgroundBrush}" />
				</Style>
			</Grid.Styles>

			<Grid.ContextFlyout>
				<controls:LazyMenuFlyout MenuTemplate="{StaticResource KeyValueRecordContextMenuTemplate}" />
			</Grid.ContextFlyout>

			<Interaction.Behaviors>
				<dragAndDrop:DatasetDropRecordInsideBehavior
					IsEnabled="{Binding $parent[UserControl].((vm:DatasetEditorViewModel)DataContext).IsReadOnly, Mode=OneWay, Converter={x:Static BoolConverters.Not}}"
					MoveCommand="{Binding $parent[UserControl].((vm:DatasetEditorViewModel)DataContext).MoveRecordCommand}"
					Records="{Binding $parent[UserControl].((vm:DatasetEditorViewModel)DataContext).Records, Mode=OneTime}" />
			</Interaction.Behaviors>

			<views:DatasetFieldView
				Grid.Column="0"
				Padding="{StaticResource RecordPadding}"
				HighlightSignal="{Binding HighlightSignal, Mode=OneWay}"
				IsSensitive="{Binding $parent[UserControl].((vm:DatasetEditorViewModel)DataContext).IsEncrypted, Mode=OneWay}"
				Text="{Binding Key, Mode=OneWay}"
				TextBlockDoubleTappedCommand="{Binding $parent[UserControl].((vm:DatasetEditorViewModel)DataContext).EditKeyValueCommand}">
				<Interaction.Behaviors>
					<dragAndDrop:DatasetRecordDragBehavior Record="{Binding Mode=OneWay}" Text="{Binding Key, Mode=OneWay}" />
				</Interaction.Behaviors>
			</views:DatasetFieldView>

			<views:DatasetFieldView
				Grid.Column="1"
				Padding="{StaticResource RecordPadding}"
				HighlightSignal="{Binding HighlightSignal, Mode=OneWay}"
				IsHidden="{Binding IsHidden, Mode=TwoWay}"
				IsHiddenChangedCommand="{Binding $parent[UserControl].((vm:DatasetEditorViewModel)DataContext).IsHiddenChangedCommand}"
				IsSensitive="{Binding $parent[UserControl].((vm:DatasetEditorViewModel)DataContext).IsEncrypted, Mode=OneWay}"
				Note="{Binding Note, Mode=OneWay}"
				NoteName="{Binding Key, Mode=OneWay}"
				Text="{Binding Value, Mode=OneWay}"
				TextBlockDoubleTappedCommand="{Binding $parent[UserControl].((vm:DatasetEditorViewModel)DataContext).EditKeyValueCommand}">
				<Interaction.Behaviors>
					<dragAndDrop:DatasetRecordDragBehavior Record="{Binding Mode=OneWay}" Text="{Binding Value, Mode=OneWay}" />
				</Interaction.Behaviors>
			</views:DatasetFieldView>
		</Grid>
	</DataTemplate>

	<!--  ValueRecordTemplate  -->
	<DataTemplate x:Key="ValueRecordTemplate" x:DataType="dataset:ValueRecord">
		<Grid Classes="PointerOverBackgroundStyle">
			<Grid.Styles>
				<Style Selector="FlyoutPresenter">
					<Setter Property="Background" Value="{StaticResource MaterialCardBackgroundBrush}" />
				</Style>
			</Grid.Styles>

			<Grid.ContextFlyout>
				<controls:LazyMenuFlyout MenuTemplate="{StaticResource ValueRecordContextMenuTemplate}" />
			</Grid.ContextFlyout>

			<Interaction.Behaviors>
				<dragAndDrop:DatasetDropRecordInsideBehavior
					IsEnabled="{Binding $parent[UserControl].((vm:DatasetEditorViewModel)DataContext).IsReadOnly, Mode=OneWay, Converter={x:Static BoolConverters.Not}}"
					MoveCommand="{Binding $parent[UserControl].((vm:DatasetEditorViewModel)DataContext).MoveRecordCommand}"
					Records="{Binding $parent[UserControl].((vm:DatasetEditorViewModel)DataContext).Records, Mode=OneTime}" />
			</Interaction.Behaviors>

			<views:DatasetFieldView
				Padding="{StaticResource RecordPadding}"
				HighlightSignal="{Binding HighlightSignal, Mode=OneWay}"
				IsHidden="{Binding IsHidden, Mode=TwoWay}"
				IsHiddenChangedCommand="{Binding $parent[UserControl].((vm:DatasetEditorViewModel)DataContext).IsHiddenChangedCommand}"
				IsSensitive="{Binding $parent[UserControl].((vm:DatasetEditorViewModel)DataContext).IsEncrypted, Mode=OneWay}"
				Note="{Binding Note, Mode=OneWay}"
				Text="{Binding Value, Mode=OneWay}"
				TextBlockDoubleTappedCommand="{Binding $parent[UserControl].((vm:DatasetEditorViewModel)DataContext).EditValueCommand}">
				<Interaction.Behaviors>
					<dragAndDrop:DatasetRecordDragBehavior Record="{Binding Mode=OneWay}" Text="{Binding Value, Mode=OneWay}" />
				</Interaction.Behaviors>
			</views:DatasetFieldView>
		</Grid>
	</DataTemplate>

	<!--  RecordsGroupTemplate  -->
	<DataTemplate x:Key="RecordsGroupTemplate" x:DataType="dataset:RecordsGroup">
		<!--  BorderBrush="{StaticResource MaterialDividerBrush}"  -->
		<Border
			Padding="4.0"
			BorderBrush="DarkGray"
			BorderThickness="1.5"
			CornerRadius="4.0">

			<Expander
				HorizontalAlignment="Stretch"
				Classes="RecordsGroupExpanderStyle"
				Content="{Binding Children, Mode=OneWay}"
				Header="{Binding Mode=OneWay}"
				IsExpanded="{Binding IsExpanded, Mode=TwoWay}">

				<!--
					The group is named for screen readers and UI Automation as the field of its header, by a neutral word while the
					dataset is encrypted; its header and its chevron take the same name.
				-->
				<AutomationProperties.Name>
					<MultiBinding Converter="{x:Static converters:AppConverters.SensitiveAutomationName}">
						<Binding Mode="OneWay" Path="Name" />

						<Binding Mode="OneWay" Path="$parent[UserControl].((vm:DatasetEditorViewModel)DataContext).IsEncrypted" />
					</MultiBinding>
				</AutomationProperties.Name>

				<Expander.Styles>
					<Style Selector="FlyoutPresenter">
						<Setter Property="Theme" Value="{StaticResource MaterialFlyoutPresenter}" />
						<Setter Property="Background" Value="{StaticResource MaterialCardBackgroundBrush}" />
					</Style>

					<Style Selector="ToolTip">
						<Setter Property="Theme" Value="{StaticResource MaterialToolTip}" />
					</Style>
				</Expander.Styles>

				<Expander.HeaderTemplate>
					<DataTemplate x:DataType="dataset:RecordsGroup">
						<Grid Classes="PointerOverBackgroundStyle" ColumnDefinitions="Auto,*">

							<Interaction.Behaviors>
								<input:ExpanderDoubleClickToggleBehavior />

								<dragAndDrop:DatasetDropRecordInsideBehavior
									IsEnabled="{Binding $parent[UserControl].((vm:DatasetEditorViewModel)DataContext).IsReadOnly, Mode=OneWay, Converter={x:Static BoolConverters.Not}}"
									MoveCommand="{Binding $parent[UserControl].((vm:DatasetEditorViewModel)DataContext).MoveRecordCommand}"
									Records="{Binding $parent[UserControl].((vm:DatasetEditorViewModel)DataContext).Records, Mode=OneTime}" />
							</Interaction.Behaviors>

							<ToggleButton
								Grid.Column="0"
								Margin="0.0,0.0,4.0,0.0"
								Padding="4.0"
								VerticalAlignment="Center"
								AutomationProperties.Name="{Binding $parent[Expander].(AutomationProperties.Name), Mode=OneWay}"
								IsChecked="{Binding $parent[Expander].IsExpanded, Mode=TwoWay}"
								Theme="{StaticResource MaterialFlatButton}">
								<materialIcons:MaterialIcon
									Width="16.0"
									Height="16.0"
									Classes="HeaderChevron"
									Classes.expanded="{Binding $parent[Expander].IsExpanded, Mode=OneWay}"
									Kind="ChevronRight" />
							</ToggleButton>

							<views:DatasetFieldView
								Grid.Column="1"
								Padding="{StaticResource RecordPadding}"
								HighlightSignal="{Binding HighlightSignal, Mode=OneWay}"
								IsSensitive="{Binding $parent[UserControl].((vm:DatasetEditorViewModel)DataContext).IsEncrypted, Mode=OneWay}"
								Note="{Binding Note, Mode=OneWay}"
								NoteName="{Binding Name, Mode=OneWay}"
								Text="{Binding Name, Mode=OneWay}">
								<Interaction.Behaviors>
									<dragAndDrop:DatasetRecordDragBehavior Record="{Binding Mode=OneWay}" Text="{Binding Name, Mode=OneWay}" />
								</Interaction.Behaviors>
							</views:DatasetFieldView>
						</Grid>
					</DataTemplate>
				</Expander.HeaderTemplate>

				<Expander.ContentTemplate>
					<DataTemplate>
						<ItemsControl ItemsSource="{Binding Mode=OneWay}">
							<ItemsControl.ItemTemplate>
								<selectors:DatasetRecordTemplateSelector>
									<StaticResource ResourceKey="KeyValueRecordTemplate" />

									<StaticResource ResourceKey="RecordsGroupTemplate" />

									<StaticResource ResourceKey="ValueRecordTemplate" />
								</selectors:DatasetRecordTemplateSelector>
							</ItemsControl.ItemTemplate>

							<ItemsControl.ItemContainerTheme>
								<ControlTheme TargetType="ContentPresenter">
									<Setter Property="Margin" Value="2.0" />
								</ControlTheme>
							</ItemsControl.ItemContainerTheme>
						</ItemsControl>
					</DataTemplate>
				</Expander.ContentTemplate>

				<Expander.ContextFlyout>
					<controls:LazyMenuFlyout MenuTemplate="{StaticResource RecordsGroupContextMenuTemplate}" />
				</Expander.ContextFlyout>

				<Interaction.Behaviors>
					<styling:ExpanderToggleCursorBehavior />

					<input:ExpanderToggledByUserBehavior Command="{Binding $parent[UserControl].((vm:DatasetEditorViewModel)DataContext).GroupExpandedCollapsedByUserCommand}" />
				</Interaction.Behaviors>
			</Expander>
		</Border>
	</DataTemplate>
</ResourceDictionary>
