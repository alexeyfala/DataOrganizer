<ResourceDictionary
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:materialIcons="using:Material.Icons.Avalonia"
	xmlns:prop="using:Shared.Properties"
	xmlns:windows="using:DataOrganizer.ViewModels.Windows">

	<!-- RightSideSheetHeaderTemplate -->
	<DataTemplate x:Key="RightSideSheetHeaderTemplate">
		<StackPanel Orientation="Horizontal">
			<ToggleButton
				Classes="primary"
				Content="{materialIcons:MaterialIconTextExt Kind=ChevronDoubleRight,
				                                            IconSize={StaticResource ToolBarIconSize}}"
				IsChecked="{Binding $parent[Window].((windows:EditorViewModel)DataContext).IsRightSideSheetOpened, Mode=TwoWay}"
				Theme="{StaticResource MaterialFlatButton}"
				ToolTip.Tip="{x:Static prop:Strings.Hide}" />

			<Button
				Classes="primary"
				Command="{Binding $parent[Window].((windows:EditorViewModel)DataContext).ClearRightSideSheetCommand}"
				Content="{materialIcons:MaterialIconTextExt Kind=Close,
				                                            IconSize={StaticResource ToolBarIconSize}}"
				Foreground="{StaticResource WarningBrush}"
				Theme="{StaticResource MaterialFlatButton}"
				ToolTip.Tip="{x:Static prop:Strings.Clear}" />
		</StackPanel>
	</DataTemplate>
</ResourceDictionary>
