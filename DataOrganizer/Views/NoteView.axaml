<UserControl
	x:Class="DataOrganizer.Views.NoteView"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:clipboard="using:DataOrganizer.Interfaces.Clipboard"
	xmlns:converters="using:DataOrganizer.Converters"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:input="using:DataOrganizer.Behaviors.Input"
	xmlns:markup="using:DataOrganizer.Markup"
	xmlns:materialIcons="using:Material.Icons.Avalonia"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:prop="using:Shared.Properties"
	xmlns:security="using:DataOrganizer.Behaviors.Security"
	xmlns:text="using:DataOrganizer.Behaviors.Text"
	xmlns:views="using:DataOrganizer.Views"
	mc:Ignorable="d">

	<UserControl.Styles>
		<Style Selector="ToolTip">
			<Setter Property="Theme" Value="{StaticResource MaterialToolTip}" />
		</Style>

		<Style Selector="materialIcons|MaterialIcon.NoteIconStyle">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Cursor" Value="Help" />
			<Setter Property="Foreground" Value="{StaticResource NoteBrush}" />
			<Setter Property="Kind" Value="NoteTextOutline" />
		</Style>
	</UserControl.Styles>

	<Grid
		DataContext="{Binding $parent[views:NoteView]}"
		RowDefinitions="*,Auto">

		<!-- Encrypted -->
		<materialIcons:MaterialIcon
			Grid.Row="0"
			Classes="NoteIconStyle"
			IsVisible="{Binding IsLocked, Mode=OneWay}"
			ToolTip.Tip="{x:Static prop:Strings.ContentIsEncrypted}" />

		<!-- Readable -->
		<materialIcons:MaterialIcon
			x:Name="ReadableIcon"
			Grid.Row="0"
			Classes="NoteIconStyle"
			IsVisible="{Binding !IsLocked, Mode=OneWay}">

			<Interaction.Behaviors>
				<input:PointerHoverCommandBehavior Command="{Binding NotePointerEnteredCommand}" />
			</Interaction.Behaviors>
		</materialIcons:MaterialIcon>

		<Popup
			Grid.Row="1"
			MaxWidth="500.0"
			MaxHeight="500.0"
			IsLightDismissEnabled="True"
			IsOpen="{Binding IsNoteOpen, Mode=TwoWay}"
			Placement="Bottom"
			PlacementTarget="{Binding #ReadableIcon}"
			VerticalOffset="8.0">

			<Interaction.Behaviors>
				<EventTriggerBehavior EventName="Closed">
					<InvokeCommandAction Command="{Binding NoteClosedCommand}" />
				</EventTriggerBehavior>
			</Interaction.Behaviors>

			<Border
				Padding="8.0"
				Background="{StaticResource MaterialToolTipBackgroundBrush}"
				CornerRadius="4.0">

				<!--
					Routed events travel the logical tree, so a double tap inside the popup would reach
					the row the icon belongs to and toggle it.
				-->
				<Interaction.Behaviors>
					<DoubleTappedTrigger MarkAsHandled="True" />
				</Interaction.Behaviors>

				<Grid
					ColumnDefinitions="*,Auto"
					RowDefinitions="Auto,*">
					<TextBlock
						Grid.Row="0"
						Grid.Column="0"
						Margin="0.0,0.0,8.0,8.0"
						Classes="HeaderTextBlockStyle"
						Foreground="{StaticResource MaterialPaperBrush}"
						Text="{Binding NoteName, Mode=OneWay, Converter={x:Static converters:AppConverters.NoteHeader}}"
						TextTrimming="CharacterEllipsis" />

					<ToggleButton
						Grid.Row="0"
						Grid.Column="1"
						Margin="0.0,0.0,0.0,8.0"
						Padding="0.0"
						HorizontalAlignment="Right"
						Content="{materialIcons:MaterialIconTextExt Kind=Close,
						                                            IconSize={StaticResource ToolBarIconSize}}"
						Cursor="Arrow"
						Foreground="{StaticResource MaterialPaperBrush}"
						IsChecked="{Binding !IsNoteOpen, Mode=TwoWay}"
						Theme="{StaticResource MaterialFlatButton}"
						ToolTip.Tip="{x:Static prop:Strings.Close}" />

					<ScrollViewer
						Grid.Row="1"
						Grid.Column="0"
						Grid.ColumnSpan="2"
						HorizontalScrollBarVisibility="Disabled"
						VerticalScrollBarVisibility="Auto">
						<SelectableTextBlock
							x:Name="NoteText"
							FontFamily="Cascadia Code,Consolas,Menlo,Monospace"
							FontSize="14.0"
							Foreground="{StaticResource MaterialPaperBrush}"
							TextWrapping="Wrap">
							<SelectableTextBlock.Styles>
								<Style Selector="MenuItem">
									<Setter Property="Cursor" Value="Arrow" />
									<Setter Property="MaxHeight" Value="24.0" />
								</Style>
							</SelectableTextBlock.Styles>

							<SelectableTextBlock.ContextFlyout>
								<MenuFlyout>
									<MenuItem
										Command="{Binding CopySelectedNoteCommand}"
										CommandParameter="{Binding #NoteText}"
										Header="{x:Static prop:Strings.Copy}"
										InputGesture="{OnPlatform Default='Ctrl+C',
										                          macOS='⌘+C'}" />
								</MenuFlyout>
							</SelectableTextBlock.ContextFlyout>

							<Interaction.Behaviors>
								<text:HyperlinkInlinesBehavior Text="{Binding DisplayedNote}" />

								<security:SensitiveCopyBehavior
									IsSensitive="{Binding IsSensitive, Mode=OneWay}"
									Writer="{markup:Resolve {x:Type clipboard:ISensitiveClipboardWriter}}" />
							</Interaction.Behaviors>
						</SelectableTextBlock>
					</ScrollViewer>
				</Grid>
			</Border>
		</Popup>
	</Grid>
</UserControl>
