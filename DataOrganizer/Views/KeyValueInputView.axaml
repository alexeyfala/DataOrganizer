<UserControl
	x:Class="DataOrganizer.Views.KeyValueInputView"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:assists="using:Material.Styles.Assists"
	xmlns:behaviors="using:DataOrganizer.Behaviors"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:prop="using:Shared.Properties"
	xmlns:vm="using:DataOrganizer.ViewModels"
	x:DataType="vm:KeyValueInputViewModel"
	Theme="{StaticResource DialogTheme}"
	mc:Ignorable="d">

	<UserControl.Styles>
		<Style Selector="TextBox.revealPasswordButton">
			<Setter Property="PasswordChar" Value="*" />
		</Style>
	</UserControl.Styles>

	<!--  A stack, not a grid: a hidden child takes no spacing, so the optional value input leaves no gap.  -->
	<StackPanel
		Orientation="Vertical"
		Spacing="{StaticResource ElementSpacing}">

		<TextBox
			assists:TextFieldAssist.Label="{Binding KeyHint, Mode=OneWay}"
			Classes.clearButton="{Binding !IsKeyMasked, Mode=OneWay}"
			Classes.revealPasswordButton="{Binding IsKeyMasked, Mode=OneWay}"
			Text="{Binding Key, Mode=TwoWay}"
			UseFloatingPlaceholder="True">
			<Interaction.Behaviors>
				<AutoFocusBehavior />
				<AutoSelectBehavior />

				<behaviors:MoveFocusOnEnterBehavior
					IsMoveAllowed="{Binding IsKeyAccepted, Mode=OneWay}"
					Target="{Binding #ValueInput}" />
			</Interaction.Behaviors>
		</TextBox>

		<TextBox
			x:Name="ValueInput"
			assists:TextFieldAssist.Label="{Binding ValueHint, Mode=OneWay}"
			Classes.clearButton="{Binding !IsValueMasked, Mode=OneWay}"
			Classes.revealPasswordButton="{Binding IsValueMasked, Mode=OneWay}"
			IsVisible="{Binding IsValueInputVisible, Mode=OneWay}"
			Text="{Binding Value, Mode=TwoWay}"
			UseFloatingPlaceholder="True" />

		<UniformGrid
			HorizontalAlignment="Right"
			ColumnSpacing="{StaticResource ElementSpacing}"
			Columns="2">
			<UniformGrid.Styles>
				<Style Selector="Button">
					<Setter Property="Theme" Value="{StaticResource MaterialFlatButton}" />
				</Style>
			</UniformGrid.Styles>

			<Button
				Classes="primary"
				Command="{Binding DefaultPressedCommand}"
				Content="{Binding DefaultButtonText, Mode=OneWay}"
				IsDefault="True" />

			<Button
				Classes="primary"
				Command="{Binding CancelCommand}"
				Content="{x:Static prop:Strings.Cancel}"
				IsCancel="True" />
		</UniformGrid>
	</StackPanel>
</UserControl>
