<UserControl
	x:Class="DataOrganizer.Views.TitleBarView"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:chrome="using:Avalonia.Controls.Chrome"
	xmlns:converters="using:DataOrganizer.Converters"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:materialIcons="using:Material.Icons.Avalonia"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:prop="using:Shared.Properties"
	x:Name="View"
	mc:Ignorable="d">

	<UserControl.Styles>
		<StyleInclude Source="/Styling/TitleBarStyles.axaml" />
	</UserControl.Styles>

	<Border
		Height="{StaticResource TitleBarHeight}"
		chrome:WindowDecorationProperties.ElementRole="TitleBar"
		Background="Transparent">

		<Panel>
			<Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
				<Panel Grid.Column="0" Width="{StaticResource TrafficLightsWidth}" />

				<StackPanel
					Grid.Column="4"
					IsVisible="{StaticResource AreCaptionButtonsVisible}"
					Orientation="Horizontal">

					<Button
						chrome:WindowDecorationProperties.ElementRole="MinimizeButton"
						Classes="CaptionButtonStyle"
						Content="{materialIcons:MaterialIconExt Kind=WindowMinimize,
						                                        IconSize={StaticResource CaptionIconSize}}">
						<Interaction.Behaviors>
							<EventTriggerBehavior EventName="Click">
								<WindowAction ActionType="Minimize" />
							</EventTriggerBehavior>
						</Interaction.Behaviors>
					</Button>

					<ToggleButton
						x:Name="MaximizeButton"
						chrome:WindowDecorationProperties.ElementRole="MaximizeButton"
						Classes="CaptionButtonStyle"
						IsChecked="{Binding $parent[Window].WindowState, Converter={x:Static converters:AppConverters.WindowStateToBool}, Mode=TwoWay}" />

					<Button
						chrome:WindowDecorationProperties.ElementRole="CloseButton"
						Classes="CaptionButtonStyle CloseCaptionButtonStyle"
						Content="{materialIcons:MaterialIconExt Kind=WindowClose,
						                                        IconSize={StaticResource CaptionIconSize}}">
						<Interaction.Behaviors>
							<EventTriggerBehavior EventName="Click">
								<CloseWindowAction />
							</EventTriggerBehavior>
						</Interaction.Behaviors>
					</Button>
				</StackPanel>

				<!--  The slot keeps the inherited data context for the button placed in it.  -->
				<ContentPresenter Grid.Column="2" Content="{Binding #View.ButtonContent, Mode=OneWay}" />

				<ToggleSwitch
					x:Name="TopmostSwitch"
					Grid.Column="3"
					Margin="8.0,0.0"
					chrome:WindowDecorationProperties.ElementRole="User"
					Classes="accent PinToggleSwitchStyle CompactToggleSwitchStyle"
					IsChecked="{Binding $parent[Window].Topmost, Mode=TwoWay}"
					ToolTip.Tip="{x:Static prop:Strings.Topmost}" />
			</Grid>

			<!--
				The caption takes no pointer input on purpose: a hit test reports the topmost element alone,
				so a press has to reach the border underneath, the one carrying the title bar role.
			-->
			<DockPanel
				Margin="{StaticResource TitleBarContentMargin}"
				HorizontalAlignment="{StaticResource TitleBarContentAlignment}"
				VerticalAlignment="Center"
				ClipToBounds="True"
				IsHitTestVisible="False">

				<Image
					Margin="0.0,0.0,8.0,0.0"
					Classes="AppImageStyle"
					DockPanel.Dock="Left"
					RenderOptions.BitmapInterpolationMode="HighQuality" />

				<TextBlock
					x:Name="WindowTitle"
					VerticalAlignment="Center"
					FontFamily="{StaticResource TitleBarFontFamily}"
					FontSize="{StaticResource TitleBarFontSize}"
					FontWeight="{StaticResource TitleBarFontWeight}"
					Text="{Binding $parent[Window].Title, Mode=OneWay}"
					TextTrimming="CharacterEllipsis" />
			</DockPanel>
		</Panel>
	</Border>
</UserControl>
