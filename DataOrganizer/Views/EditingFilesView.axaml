<UserControl
	x:Class="DataOrganizer.Views.EditingFilesView"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:assists="using:Material.Styles.Assists"
	xmlns:behaviors="using:DataOrganizer.Behaviors"
	xmlns:controls="using:DataOrganizer.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="using:DataOrganizer.ViewModels"
	x:DataType="vm:EditingFilesViewModel"
	mc:Ignorable="d">

	<controls:RightClickSelectableTabControl
		assists:TabControlAssist.TabHeaderHorizontalAlignment="Left"
		AutoScrollToSelectedItem="True"
		IsVisible="{Binding Items.Count, Mode=OneWay}"
		ItemTemplate="{StaticResource EditingFileTabControlHeaderTemplate}"
		ItemsSource="{Binding Items, Mode=OneTime}"
		SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
		Theme="{StaticResource ContentSizedTabControlTheme}">

		<controls:RightClickSelectableTabControl.KeyBindings>
			<KeyBinding
				Command="{Binding SwitchToPreviousTabCommand}"
				Gesture="Ctrl+Tab" />
		</controls:RightClickSelectableTabControl.KeyBindings>

		<Interaction.Behaviors>
			<behaviors:MiddleClickTabCommandBehavior Command="{Binding CloseTabCommand}" />

			<EventTriggerBehavior EventName="SelectionChanged">
				<InvokeCommandAction
					Command="{Binding SelectionChangedCommand}"
					PassEventArgsToCommand="True" />
			</EventTriggerBehavior>
		</Interaction.Behaviors>

		<controls:RightClickSelectableTabControl.Styles>
			<Style Selector="TabItem">
				<Setter Property="(Interaction.Behaviors)">
					<BehaviorCollectionTemplate>
						<BehaviorCollection>
							<behaviors:LazyContextFlyoutBehavior ContentTemplate="{StaticResource EditingFileTabContextMenuTemplate}" />
						</BehaviorCollection>
					</BehaviorCollectionTemplate>
				</Setter>
			</Style>
		</controls:RightClickSelectableTabControl.Styles>
	</controls:RightClickSelectableTabControl>
</UserControl>
