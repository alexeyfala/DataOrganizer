<UserControl
	x:Class="DataOrganizer.Views.EmbeddedFileEditorView"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:materialIcons="using:Material.Icons.Avalonia"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:prop="using:Shared.Properties"
	xmlns:views="using:DataOrganizer.Views"
	xmlns:vm="using:DataOrganizer.ViewModels"
	x:DataType="vm:EmbeddedFileEditorViewModel"
	mc:Ignorable="d">

	<views:DocumentEditorView
		x:Name="Editor"
		DefaultEncoding="{Binding Editor.DefaultEncoding, Mode=OneWay}"
		DefaultSyntaxLanguage="{Binding Editor.DefaultSyntaxLanguage, Mode=OneWay}"
		DefaultSyntaxLanguageMark="{x:Static prop:Strings.ByExtension}"
		Document="{Binding Editor.Document, Mode=OneWay}"
		DocumentFontSize="{Binding Editor.FontSize, Mode=TwoWay}"
		Encoding="{Binding Editor.Encoding, Mode=TwoWay}"
		EncodingName="{Binding Editor.EncodingName, Mode=OneWay}"
		FindUnreadableEncodingsCommand="{Binding Editor.FindUnreadableEncodingsCommand, Mode=OneWay}"
		IsReadOnly="{Binding !IsEditingEnabled, Mode=OneWay}"
		IsSensitive="{Binding IsEncrypted, Mode=OneWay}"
		IsSplit="{Binding Editor.IsSplit, Mode=TwoWay}"
		ShowEndOfLine="{Binding Editor.ShowEndOfLine, Mode=TwoWay}"
		ShowSpaces="{Binding Editor.ShowSpaces, Mode=TwoWay}"
		ShowTabs="{Binding Editor.ShowTabs, Mode=TwoWay}"
		SplitShare="{Binding Editor.SplitShare, Mode=TwoWay}"
		SyntaxLanguage="{Binding Editor.SyntaxLanguage, Mode=TwoWay}"
		UnreadableEncodings="{Binding Editor.UnreadableEncodings, Mode=OneWay}"
		ViewState="{Binding Editor.ViewState, Mode=TwoWay}"
		WordWrap="{Binding Editor.WordWrap, Mode=TwoWay}">

		<Interaction.Behaviors>
			<EventTriggerBehavior EventName="Loaded">
				<InvokeCommandAction Command="{Binding EditorLoadedCommand}" />
			</EventTriggerBehavior>
		</Interaction.Behaviors>

		<views:DocumentEditorView.ToolBarContent>
			<Button
				Classes="primary"
				Command="{Binding ShowInListCommand}"
				CommandParameter="{Binding $parent[Window]}"
				Content="{materialIcons:MaterialIconTextExt Kind=FileTree,
				                                            IconSize={StaticResource ToolBarIconSize}}"
				ToolTip.Tip="{x:Static prop:Strings.ShowInList}" />
		</views:DocumentEditorView.ToolBarContent>
	</views:DocumentEditorView>
</UserControl>
