<UserControl
	x:Class="DataOrganizer.Views.Settings.SettingsClipboardView"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:dialogs="using:DataOrganizer.ViewModels.Dialogs"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:prop="using:Shared.Properties"
	x:DataType="dialogs:SettingsViewModel"
	mc:Ignorable="d">

	<HeaderedContentControl
		Classes="ClassicGroupBoxStyle"
		Header="{x:Static prop:Strings.Clipboard}">
		<StackPanel
			Margin="10.0"
			Orientation="Vertical"
			Spacing="{StaticResource ElementSpacing}">
			<StackPanel Orientation="Vertical">
				<CheckBox
					Content="{x:Static prop:Strings.EnableClipboardHistoryTracking}"
					IsChecked="{Binding TrackClipboardHistory, Mode=TwoWay}" />

				<TextBlock
					Classes="SupportingTextBlockStyle"
					Text="{x:Static prop:Strings.ClipboardDescription}" />
			</StackPanel>

			<CheckBox
				Content="{x:Static prop:Strings.PersistHistoryBetweenSessions}"
				IsChecked="{Binding PersistClipboardHistory, Mode=TwoWay}"
				IsEnabled="{Binding TrackClipboardHistory, Mode=OneWay}" />
		</StackPanel>
	</HeaderedContentControl>
</UserControl>
