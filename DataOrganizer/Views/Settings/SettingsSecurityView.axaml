<UserControl
	x:Class="DataOrganizer.Views.Settings.SettingsSecurityView"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:converters="using:DataOrganizer.Converters"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:prop="using:Shared.Properties"
	xmlns:vm="using:DataOrganizer.ViewModels"
	x:DataType="vm:SettingsViewModel"
	mc:Ignorable="d">

	<HeaderedContentControl
		Classes="ClassicGroupBoxStyle"
		Header="{x:Static prop:Strings.AutoLock}">
		<StackPanel Orientation="Vertical">
			<ComboBox
				Height="{StaticResource SettingsComboBoxHeight}"
				ItemsSource="{Binding AutoLockDelays, Mode=OneTime}"
				SelectedItem="{Binding AutoLockMinutes, Mode=TwoWay}">
				<ComboBox.ItemTemplate>
					<DataTemplate>
						<TextBlock Text="{Binding Mode=OneWay, Converter={x:Static converters:AppConverters.AutoLockDelay}}" />
					</DataTemplate>
				</ComboBox.ItemTemplate>
			</ComboBox>

			<TextBlock
				Margin="10.0,4.0,0.0,0.0"
				Classes="SupportingTextBlockStyle"
				Text="{x:Static prop:Strings.AutoLockDescription}"
				TextWrapping="Wrap" />
		</StackPanel>
	</HeaderedContentControl>
</UserControl>
