<UserControl
	x:Class="DataOrganizer.Views.Settings.SettingsView"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:materialIcons="using:Material.Icons.Avalonia"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:prop="using:Shared.Properties"
	xmlns:settings="using:DataOrganizer.Views.Settings"
	xmlns:vm="using:DataOrganizer.ViewModels"
	xmlns:wrappers="using:DataOrganizer.Wrappers"
	Padding="{StaticResource DialogIndent}"
	x:DataType="vm:SettingsViewModel"
	mc:Ignorable="d">

	<Grid
		RowDefinitions="Auto,*"
		RowSpacing="{StaticResource ElementSpacing}">
		<Button
			Grid.Row="0"
			HorizontalAlignment="Left"
			Classes="primary"
			Command="{Binding SaveAndCloseCommand}"
			Content="{materialIcons:MaterialIconTextExt Kind=ContentSaveOutline,
			                                            IconSize={StaticResource ToolBarIconSize}}"
			Theme="{StaticResource MaterialFlatButton}"
			ToolTip.Tip="{x:Static prop:Strings.SaveAndClose}" />

		<Grid
			Grid.Row="1"
			ColumnDefinitions="Auto,*"
			ColumnSpacing="{StaticResource ElementSpacing}">
			<Grid.Styles>
				<Style Selector="ListBoxItem materialIcons|MaterialIcon">
					<Setter Property="Width" Value="{StaticResource SmallButtonIconSize}" />
					<Setter Property="Height" Value="{StaticResource SmallButtonIconSize}" />
				</Style>

				<Style Selector="ListBoxItem TextBlock">
					<Setter Property="VerticalAlignment" Value="Center" />
				</Style>
			</Grid.Styles>

			<ScrollViewer
				Grid.Column="0"
				HorizontalScrollBarVisibility="Disabled"
				VerticalScrollBarVisibility="Auto">
				<ListBox
					Name="CategoriesListBox"
					SelectedIndex="0"
					SelectionMode="AlwaysSelected">
					<ListBoxItem>
						<StackPanel
							Orientation="Horizontal"
							Spacing="{StaticResource ElementSpacing}">
							<materialIcons:MaterialIcon Kind="Cog" />

							<TextBlock Text="{x:Static prop:Strings.General}" />
						</StackPanel>
					</ListBoxItem>

					<ListBoxItem>
						<StackPanel
							Orientation="Horizontal"
							Spacing="{StaticResource ElementSpacing}">
							<materialIcons:MaterialIcon Kind="Palette" />

							<TextBlock Text="{x:Static prop:Strings.Appearance}" />
						</StackPanel>
					</ListBoxItem>

					<ListBoxItem>
						<StackPanel
							Orientation="Horizontal"
							Spacing="{StaticResource ElementSpacing}">
							<materialIcons:MaterialIcon Kind="GestureTapButton" />

							<TextBlock Text="{x:Static prop:Strings.Behavior}" />
						</StackPanel>
					</ListBoxItem>

					<ListBoxItem>
						<StackPanel
							Orientation="Horizontal"
							Spacing="{StaticResource ElementSpacing}">
							<materialIcons:MaterialIcon Kind="ClipboardOutline" />

							<TextBlock Text="{x:Static prop:Strings.Clipboard}" />
						</StackPanel>
					</ListBoxItem>
				</ListBox>
			</ScrollViewer>

			<!--
				The panel keeps the height of the tallest section, so switching a category does not
				resize the dialog; the scroll viewer only kicks in once that height outgrows the window.
			-->
			<ScrollViewer
				Grid.Column="1"
				HorizontalScrollBarVisibility="Disabled"
				VerticalScrollBarVisibility="Auto">
				<wrappers:MaxSizeSwitchPanel SelectedIndex="{Binding #CategoriesListBox.SelectedIndex, Mode=OneWay}">
					<settings:SettingsGeneralView />

					<settings:SettingsAppearanceView />

					<settings:SettingsBehaviorView />

					<settings:SettingsClipboardView />
				</wrappers:MaxSizeSwitchPanel>
			</ScrollViewer>
		</Grid>
	</Grid>
</UserControl>
