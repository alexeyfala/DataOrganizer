<UserControl
	x:Class="DataOrganizer.Views.SelectedFavoritesView"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:converters="using:DataOrganizer.Converters"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:dragAndDrop="using:DataOrganizer.Behaviors.DragAndDrop"
	xmlns:hierarchy="using:DataOrganizer.Behaviors.Hierarchy"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="using:DataOrganizer.ViewModels"
	x:DataType="vm:SelectedFavoritesViewModel"
	mc:Ignorable="d">

	<Interaction.Behaviors>
		<EventTriggerBehavior EventName="SizeChanged">
			<InvokeCommandAction
				Command="{Binding SizeChangedCommand}"
				InputConverter="{x:Static converters:AppConverters.SizeChangedToWidth}"
				PassEventArgsToCommand="True" />
		</EventTriggerBehavior>
	</Interaction.Behaviors>

	<Grid RowDefinitions="Auto,*">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="{Binding NavigationColumnWidth, Mode=TwoWay, Converter={x:Static converters:AppConverters.PixelsToGridLength}}" />
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>

		<TextBox
			Grid.Row="0"
			Grid.Column="0"
			Classes="clearButton SearchTextBoxStyle"
			Text="{Binding CategorySearch, Mode=TwoWay}" />

		<!--
			Virtualization is disabled because switching to edge elements does not work when using "Ctrl+Tab"
		-->
		<ListBox
			Grid.Row="1"
			Grid.Column="0"
			Classes="NonVirtualizedListBoxStyle"
			ItemTemplate="{StaticResource FavoriteCategoryTemplate}"
			ItemsSource="{Binding Categories, Mode=OneTime}"
			SelectedItem="{Binding SelectedCategory, Mode=TwoWay}">
			<ListBox.KeyBindings>
				<KeyBinding Command="{Binding SwitchToPreviousCommand}" Gesture="Ctrl+Tab" />
			</ListBox.KeyBindings>

			<Interaction.Behaviors>
				<dragAndDrop:AutoScrollOnDragBehavior />
			</Interaction.Behaviors>

			<ListBox.Styles>
				<Style Selector="ListBoxItem">
					<Setter Property="(Interaction.Behaviors)">
						<BehaviorCollectionTemplate>
							<BehaviorCollection>
								<dragAndDrop:ItemDragBehavior ItemDraggedCommand="{Binding CategoryDraggedCommand}" Orientation="Vertical" />
							</BehaviorCollection>
						</BehaviorCollectionTemplate>
					</Setter>
				</Style>
				<Style Selector="ListBoxItem:dragging">
					<Setter Property="Opacity" Value="0.6" />
				</Style>
			</ListBox.Styles>
		</ListBox>

		<GridSplitter
			Grid.Row="0"
			Grid.RowSpan="2"
			Grid.Column="1"
			ResizeDirection="Columns"
			Theme="{StaticResource SingleLineGridSplitterTheme}" />

		<TextBox
			Grid.Row="0"
			Grid.Column="2"
			Classes="clearButton SearchTextBoxStyle"
			Text="{Binding FavoriteSearch, Mode=TwoWay}" />

		<ListBox
			Grid.Row="1"
			Grid.Column="2"
			ItemTemplate="{StaticResource FileInListTemplate}"
			ItemsSource="{Binding Favorites, Mode=OneTime}"
			SelectedItem="{Binding SelectedFavorite, Mode=TwoWay}">
			<Interaction.Behaviors>
				<hierarchy:ExplorerItemSignalsBehavior HighlightSignal="{Binding HighlightSignal, Mode=OneWay}" />
			</Interaction.Behaviors>
		</ListBox>
	</Grid>
</UserControl>
