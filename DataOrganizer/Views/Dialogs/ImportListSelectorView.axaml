<UserControl
	x:Class="DataOrganizer.Views.Dialogs.ImportListSelectorView"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="using:DataOrganizer.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:dialogs="using:DataOrganizer.ViewModels.Dialogs"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:prop="using:Shared.Properties"
	x:DataType="dialogs:ImportListSelectorViewModel"
	Theme="{StaticResource DialogTheme}"
	mc:Ignorable="d">

	<StackPanel
		Orientation="Vertical"
		Spacing="{StaticResource ElementSpacing}">
		<TextBlock
			Classes="HeaderTextBlockStyle"
			Text="{Binding Header, Mode=OneWay}" />

		<StackPanel
			Orientation="Vertical"
			Spacing="{StaticResource ElementSpacing}">
			<RadioButton
				Content="{x:Static prop:Strings.ReplaceTheList}"
				IsChecked="{Binding Replace, Mode=TwoWay}" />

			<RadioButton
				Content="{x:Static prop:Strings.AddToEndOfList}"
				IsChecked="{Binding AddToList, Mode=TwoWay}" />
		</StackPanel>

		<controls:DialogButtons
			HorizontalAlignment="Right"
			CancelCommand="{Binding CancelCommand}"
			Command="{Binding ApplyCommand}"
			Text="{x:Static prop:Strings.Apply}" />
	</StackPanel>
</UserControl>
