<UserControl
	x:Class="DataOrganizer.Views.Dialogs.PasswordBoxView"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:assists="using:Material.Styles.Assists"
	xmlns:controls="using:DataOrganizer.Controls"
	xmlns:converters="using:DataOrganizer.Converters"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:dialogs="using:DataOrganizer.ViewModels.Dialogs"
	xmlns:input="using:DataOrganizer.Behaviors.Input"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:prop="using:Shared.Properties"
	xmlns:security="using:DataOrganizer.Behaviors.Security"
	x:DataType="dialogs:PasswordBoxViewModel"
	Theme="{StaticResource DialogTheme}"
	mc:Ignorable="d">

	<StackPanel
		MaxWidth="460"
		Orientation="Vertical"
		Spacing="{StaticResource ElementSpacing}">

		<TextBlock
			Classes="HeaderTextBlockStyle"
			Text="{Binding Header, Mode=OneWay}" />

		<TextBlock
			IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}, Mode=OneWay}"
			Text="{Binding Description, Mode=OneWay}"
			TextWrapping="Wrap" />

		<!--  The name generates the field DialogService reads to capture the entered password.  -->
		<controls:SecretTextBox
			x:Name="PasswordInput"
			assists:TextFieldAssist.Hints="{Binding PasswordHint, Mode=OneWay}"
			assists:TextFieldAssist.Label="{Binding Label, Mode=OneWay}"
			Classes="revealPasswordButton"
			IsUndoEnabled="False"
			PasswordChar="*"
			UseFloatingPlaceholder="True">
			<Interaction.Behaviors>
				<AutoFocusBehavior />

				<security:WipeReplacedTextBehavior />

				<input:MoveFocusOnEnterBehavior
					IsMoveAllowed="{Binding IsPasswordAccepted, Mode=OneWay}"
					Target="{Binding #ConfirmationInput}" />

				<security:PasswordValidityBehavior
					ConfirmationInput="{Binding #ConfirmationInput}"
					IsConfirmationRequired="{Binding IsConfirmationVisible, Mode=OneWay}"
					IsPasswordAccepted="{Binding IsPasswordAccepted, Mode=OneWayToSource}"
					IsValid="{Binding IsPasswordValid, Mode=OneWayToSource}"
					MinimumLength="{x:Static dialogs:PasswordBoxViewModel.MinimumPasswordLength}"
					MismatchMessage="{x:Static prop:Strings.PasswordsDoNotMatch}"
					Strength="{Binding Strength, Mode=OneWayToSource}"
					TooShortMessage="{Binding PasswordHint, Mode=OneWay}" />
			</Interaction.Behaviors>
		</controls:SecretTextBox>

		<StackPanel
			IsVisible="{Binding IsConfirmationVisible, Mode=OneWay}"
			Orientation="Vertical">

			<ProgressBar
				Height="4.0"
				Foreground="{Binding Strength, Converter={x:Static converters:SecurityConverters.PasswordStrengthToBrush}, Mode=OneWay}"
				Maximum="4.0"
				Minimum="0.0"
				Value="{Binding Strength, Converter={x:Static converters:SecurityConverters.PasswordStrengthToValue}, Mode=OneWay}" />

			<TextBlock
				HorizontalAlignment="Right"
				Classes="SupportingTextBlockStyle"
				Foreground="{Binding Strength, Converter={x:Static converters:SecurityConverters.PasswordStrengthToBrush}, Mode=OneWay}"
				Text="{Binding Strength, Converter={x:Static converters:SecurityConverters.PasswordStrengthToCaption}, Mode=OneWay}" />
		</StackPanel>

		<controls:SecretTextBox
			x:Name="ConfirmationInput"
			assists:TextFieldAssist.Label="{x:Static prop:Strings.ConfirmPassword}"
			Classes="revealPasswordButton"
			IsUndoEnabled="False"
			IsVisible="{Binding IsConfirmationVisible, Mode=OneWay}"
			PasswordChar="*"
			UseFloatingPlaceholder="True">
			<Interaction.Behaviors>
				<security:WipeReplacedTextBehavior />
			</Interaction.Behaviors>
		</controls:SecretTextBox>

		<controls:DialogButtons
			HorizontalAlignment="Right"
			CancelCommand="{Binding CancelCommand}"
			Command="{Binding ApplyCommand}"
			Text="{x:Static prop:Strings.Apply}" />
	</StackPanel>
</UserControl>
