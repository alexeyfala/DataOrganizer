<UserControl
	x:Class="DataOrganizer.Views.Dialogs.EntityCreationView"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:assists="using:Material.Styles.Assists"
	xmlns:controls="using:DataOrganizer.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:dialogs="using:DataOrganizer.ViewModels.Dialogs"
	xmlns:materialIcons="using:Material.Icons.Avalonia"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:prop="using:Shared.Properties"
	x:DataType="dialogs:EntityCreationViewModel"
	Theme="{StaticResource DialogTheme}"
	mc:Ignorable="d">

	<StackPanel
		Orientation="Vertical"
		Spacing="{StaticResource ElementSpacing}">

		<StackPanel
			Orientation="Vertical"
			Spacing="{StaticResource ElementSpacing}">

			<StackPanel.Resources>
				<Thickness x:Key="FileMargin">12.0,0.0,0.0,0.0</Thickness>
			</StackPanel.Resources>

			<StackPanel.Styles>
				<Style Selector="materialIcons|MaterialIcon">
					<Setter Property="Width" Value="{StaticResource EntityKindIconSize}" />
					<Setter Property="Height" Value="{StaticResource EntityKindIconSize}" />
					<Setter Property="Margin" Value="4.0,0.0" />
				</Style>

				<Style Selector="TextBlock">
					<Setter Property="VerticalAlignment" Value="Center" />
				</Style>

				<Style Selector="StackPanel">
					<Setter Property="Orientation" Value="Horizontal" />
				</Style>
			</StackPanel.Styles>

			<RadioButton
				AutomationProperties.Name="{x:Static prop:Strings.Folder}"
				IsChecked="{Binding IsFolderSelected, Mode=TwoWay}">
				<StackPanel>
					<materialIcons:MaterialIcon
						Foreground="{StaticResource FolderBrush}"
						Kind="{StaticResource FolderIconKind}" />

					<TextBlock Text="{x:Static prop:Strings.Folder}" />
				</StackPanel>
			</RadioButton>

			<RadioButton
				Margin="{StaticResource FileMargin}"
				AutomationProperties.Name="{x:Static prop:Strings.File}"
				IsChecked="{Binding IsFileSelected, Mode=TwoWay}">
				<StackPanel>
					<materialIcons:MaterialIcon
						Foreground="{StaticResource FileBrush}"
						Kind="{StaticResource FileIconKind}" />

					<TextBlock Text="{x:Static prop:Strings.File}" />
				</StackPanel>
			</RadioButton>

			<RadioButton
				Margin="{StaticResource FileMargin}"
				AutomationProperties.Name="{x:Static prop:Strings.Dataset}"
				IsChecked="{Binding IsDatasetSelected, Mode=TwoWay}">
				<StackPanel>
					<materialIcons:MaterialIcon
						Foreground="{StaticResource FileBrush}"
						Kind="{StaticResource DatasetIconKind}" />

					<TextBlock Text="{x:Static prop:Strings.Dataset}" />
				</StackPanel>
			</RadioButton>
		</StackPanel>

		<TextBox
			assists:TextFieldAssist.Label="{Binding NameInputHint, Mode=OneWay}"
			Classes="clearButton"
			Text="{Binding Name, Mode=TwoWay}"
			UseFloatingPlaceholder="True">
			<Interaction.Behaviors>
				<AutoFocusBehavior />
				<AutoSelectBehavior />
			</Interaction.Behaviors>
		</TextBox>

		<controls:DialogButtons
			HorizontalAlignment="Right"
			CancelCommand="{Binding CancelCommand}"
			Command="{Binding SaveCommand}"
			Text="{x:Static prop:Strings.Add}" />
	</StackPanel>
</UserControl>
