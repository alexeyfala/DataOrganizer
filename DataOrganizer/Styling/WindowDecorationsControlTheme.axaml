<!--
	Empty replacement of the drawn window decorations of Avalonia.
	
	Source: https://github.com/AvaloniaUI/Avalonia/blob/master/src/Avalonia.Themes.Fluent/Controls/WindowDrawnDecorations.xaml
	
	Windows grants the system menu only to a window with full decorations, while the border, the title
	and the caption buttons of the original theme would land on top of the ones drawn by the application.
	
	Meant for full decorations only: the theme sets no frame or shadow thickness, while with BorderOnly
	on Linux these two give the resize grips their width.
	
	TODO: Avalonia 12.1.6 opens that menu from the task bar button and by Alt+Space, but not from a right
	click on the title bar: the fix (PR #21630, WM_NCRBUTTONUP and WM_INITMENU) is on master only.
	Check each new release of Avalonia and drop this note once one carries the fix.
-->
<ResourceDictionary
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<ControlTheme
		x:Key="EmptyWindowDecorationsControlTheme"
		TargetType="WindowDrawnDecorations">
		<Setter Property="Template">
			<WindowDrawnDecorationsTemplate>
				<WindowDrawnDecorationsContent />
			</WindowDrawnDecorationsTemplate>
		</Setter>
	</ControlTheme>
</ResourceDictionary>
