<ResourceDictionary
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:assists="using:Material.Styles.Assists"
	xmlns:controls="using:DataOrganizer.Controls"
	xmlns:materialControls="using:Material.Styles.Controls"
	xmlns:materialIcons="using:Material.Icons.Avalonia"
	xmlns:prop="using:Shared.Properties"
	xmlns:system="using:System">

	<ControlTheme
		x:Key="CustomClipboardButtonTheme"
		BasedOn="{StaticResource MaterialFlatButton}"
		TargetType="Button">
		<Setter Property="Content">
			<Setter.Value>
				<Template>
					<materialIcons:MaterialIcon
						Width="{StaticResource ToolBarIconSize}"
						Height="{StaticResource ToolBarIconSize}"
						Kind="ClipboardOutline" />
				</Template>
			</Setter.Value>
		</Setter>
		<Setter Property="ToolTip.Tip">
			<Setter.Value>
				<Template>
					<ToolTip>
						<TextBlock>
							<Run Text="{x:Static prop:Strings.Clipboard}" />
						</TextBlock>
					</ToolTip>
				</Template>
			</Setter.Value>
		</Setter>
	</ControlTheme>

	<ControlTheme x:Key="DialogTheme" TargetType="UserControl">
		<Setter Property="MinWidth" Value="300.0" />
		<Setter Property="Padding" Value="{StaticResource DialogIndent}" />
	</ControlTheme>

	<ControlTheme
		x:Key="DocumentTabItemTheme"
		BasedOn="{StaticResource MaterialTabItem}"
		TargetType="TabItem">
		<Setter Property="MinWidth" Value="0.0" />
		<Setter Property="MinHeight" Value="0.0" />
		<Setter Property="Padding" Value="6.0" />
		<Setter Property="MaxWidth" Value="{x:Static system:Double.PositiveInfinity}" />
		<Style Selector="^:selected">
			<Setter Property="TextBlock.FontWeight" Value="Bold" />
		</Style>
	</ControlTheme>

	<ControlTheme
		x:Key="{x:Type controls:DocumentTabControl}"
		BasedOn="{StaticResource ScrollableTabControl}"
		TargetType="controls:DocumentTabControl">
		<Setter Property="assists:TabControlAssist.TabHeaderHorizontalAlignment" Value="Left" />
		<Setter Property="ItemContainerTheme" Value="{StaticResource DocumentTabItemTheme}" />

		<Setter Property="ItemsPanel">
			<ItemsPanelTemplate>
				<StackPanel HorizontalAlignment="{TemplateBinding assists:TabControlAssist.TabHeaderHorizontalAlignment}" Orientation="Horizontal" />
			</ItemsPanelTemplate>
		</Setter>

		<Setter Property="TabHeaderTemplate">
			<DataTemplate x:DataType="system:Object">
				<StackPanel
					Background="Transparent"
					Orientation="Horizontal"
					Spacing="4.0">
					<ContentPresenter Content="{Binding Mode=OneWay}" ContentTemplate="{Binding $parent[controls:DocumentTabControl].ItemTemplate, Mode=OneWay}" />

					<Button
						Margin="0.0"
						Padding="0.0"
						Classes="primary"
						Command="{Binding $parent[controls:DocumentTabControl].CloseCommand}"
						CommandParameter="{Binding}"
						Content="{materialIcons:MaterialIconTextExt Kind=Close,
						                                            IconSize={StaticResource SmallButtonIconSize}}"
						Foreground="{StaticResource WarningBrush}"
						Theme="{StaticResource MaterialFlatButton}"
						ToolTip.Tip="{x:Static prop:Strings.Close}" />
				</StackPanel>
			</DataTemplate>
		</Setter>

		<Setter Property="TabMenuTemplate">
			<DataTemplate x:DataType="system:Object">
				<StackPanel Orientation="Vertical">
					<StackPanel.Styles>
						<Style Selector="Button">
							<Setter Property="Theme" Value="{StaticResource MaterialFlatButton}" />
							<Setter Property="Foreground" Value="{StaticResource MaterialBodyBrush}" />
						</Style>
					</StackPanel.Styles>

					<controls:FlyoutButton
						Command="{Binding $parent[controls:DocumentTabControl].CloseCommand}"
						CommandParameter="{Binding}"
						Header="{x:Static prop:Strings.Close}"
						Icon="Close"
						IconForeground="{StaticResource WarningBrush}" />

					<controls:FlyoutButton
						Command="{Binding $parent[controls:DocumentTabControl].CloseOtherTabsCommand}"
						CommandParameter="{Binding}"
						Header="{x:Static prop:Strings.CloseOtherTabs}"
						Icon="CloseBoxMultipleOutline"
						IconForeground="{StaticResource WarningBrush}" />

					<controls:FlyoutButton
						Command="{Binding $parent[controls:DocumentTabControl].CloseAllTabsCommand}"
						Header="{x:Static prop:Strings.CloseAllTabs}"
						Icon="CloseBoxMultiple"
						IconForeground="{StaticResource WarningBrush}" />

					<ContentPresenter
						Content="{Binding Mode=OneWay}"
						ContentTemplate="{Binding $parent[controls:DocumentTabControl].AdditionalMenuItemsTemplate, Mode=OneWay}"
						IsVisible="{Binding $parent[controls:DocumentTabControl].AdditionalMenuItemsTemplate, Mode=OneWay, Converter={x:Static ObjectConverters.IsNotNull}}" />
				</StackPanel>
			</DataTemplate>
		</Setter>

		<Setter Property="Template">
			<ControlTemplate>
				<Border
					Name="PART_RootBorder"
					Background="{TemplateBinding Background}"
					BorderBrush="{TemplateBinding BorderBrush}"
					BorderThickness="{TemplateBinding BorderThickness}"
					CornerRadius="{TemplateBinding CornerRadius}">
					<DockPanel Name="PART_RootPanel">
						<Panel Name="PART_TabsPanel">
							<!--
								A left-aligned grid gives the tabs only the width they need, so the add button follows the last tab,
								and the star column keeps the button in sight at the right edge when the tabs overflow.
							-->
							<Grid HorizontalAlignment="Left" ColumnDefinitions="*,Auto">
								<materialControls:Scroller
									Name="PART_ScrollViewer"
									Grid.Column="0"
									Theme="{StaticResource TabControlScroller}">
									<materialControls:Scroller.Content>
										<ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
									</materialControls:Scroller.Content>
								</materialControls:Scroller>

								<Button
									Name="PART_AddButton"
									Grid.Column="1"
									Padding="6.0"
									VerticalAlignment="Stretch"
									Classes="primary"
									Command="{TemplateBinding AddCommand}"
									Content="{materialIcons:MaterialIconTextExt Kind=Plus,
									                                            IconSize={StaticResource SmallButtonIconSize}}"
									IsVisible="{TemplateBinding AddCommand,
									                            Converter={x:Static ObjectConverters.IsNotNull}}"
									Theme="{StaticResource MaterialFlatButton}"
									ToolTip.Tip="{x:Static prop:Strings.NewTab}" />
							</Grid>

							<Rectangle Name="PART_Separator" />
						</Panel>

						<!--
							The content follows the selected item, not SelectedContent: TabControl updates that one while it removes the
							container of a tab before the selected one, and shows another tab or nothing for a moment.
						-->
						<ContentPresenter
							Name="PART_ContentPresenter"
							Margin="{TemplateBinding Padding}"
							Content="{TemplateBinding SelectedItem}"
							ContentTemplate="{TemplateBinding ContentTemplate}" />
					</DockPanel>
				</Border>
			</ControlTemplate>
		</Setter>
	</ControlTheme>

	<!--
		A hairline in a wider hit area, with a grip that shows on hover.
	-->
	<ControlTheme x:Key="SingleLineGridSplitterTheme" TargetType="GridSplitter">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Focusable" Value="True" />
		<Setter Property="MinHeight" Value="8.0" />
		<Setter Property="MinWidth" Value="8.0" />
		<Setter Property="Template">
			<ControlTemplate>
				<Panel Background="{TemplateBinding Background}">
					<Border
						Name="PART_Line"
						Width="1.0"
						HorizontalAlignment="Center"
						Background="{StaticResource MaterialDividerBrush}">
						<Border.Transitions>
							<Transitions>
								<BrushTransition Property="Background" Duration="0:0:0.15" />
							</Transitions>
						</Border.Transitions>
					</Border>

					<Border
						Name="PART_Grip"
						Width="4.0"
						Height="36.0"
						Background="{StaticResource MaterialBodyLightBrush}"
						CornerRadius="2.0"
						Opacity="0.0">
						<Border.Transitions>
							<Transitions>
								<BrushTransition Property="Background" Duration="0:0:0.15" />

								<DoubleTransition Property="Opacity" Duration="0:0:0.15" />
							</Transitions>
						</Border.Transitions>
					</Border>
				</Panel>
			</ControlTemplate>
		</Setter>

		<Style Selector="^[ResizeDirection=Rows]">
			<Style Selector="^ /template/ Border#PART_Grip">
				<Setter Property="Height" Value="4.0" />
				<Setter Property="Width" Value="36.0" />
			</Style>

			<Style Selector="^ /template/ Border#PART_Line">
				<Setter Property="Height" Value="1.0" />
				<Setter Property="HorizontalAlignment" Value="Stretch" />
				<Setter Property="VerticalAlignment" Value="Center" />
				<Setter Property="Width" Value="{x:Static system:Double.NaN}" />
			</Style>
		</Style>

		<Style Selector="^:pointerover /template/ Border#PART_Grip">
			<Setter Property="Opacity" Value="1.0" />
		</Style>

		<Style Selector="^:pressed">
			<Style Selector="^ /template/ Border#PART_Grip">
				<Setter Property="Background" Value="{StaticResource MaterialPrimaryMidBrush}" />
				<Setter Property="Opacity" Value="1.0" />
			</Style>

			<Style Selector="^ /template/ Border#PART_Line">
				<Setter Property="Background" Value="{StaticResource MaterialPrimaryMidBrush}" />
			</Style>
		</Style>
	</ControlTheme>

	<!--
		Two lines, one along the edge of each side, with a filled band between them.
		The grip and its states come from the single line theme through the part name.
	-->
	<ControlTheme
		x:Key="DoubleLineGridSplitterTheme"
		BasedOn="{StaticResource SingleLineGridSplitterTheme}"
		TargetType="GridSplitter">
		<Setter Property="Background" Value="{StaticResource MaterialTextFieldBoxBackgroundBrush}" />
		<Setter Property="Template">
			<ControlTemplate>
				<Panel Background="{TemplateBinding Background}">
					<Border
						Name="PART_Lines"
						BorderBrush="{StaticResource MaterialDividerBrush}"
						BorderThickness="1.0,0.0">
						<Border.Transitions>
							<Transitions>
								<BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
							</Transitions>
						</Border.Transitions>
					</Border>

					<Border
						Name="PART_Grip"
						Width="4.0"
						Height="36.0"
						Background="{StaticResource MaterialBodyLightBrush}"
						CornerRadius="2.0"
						Opacity="0.0">
						<Border.Transitions>
							<Transitions>
								<BrushTransition Property="Background" Duration="0:0:0.15" />

								<DoubleTransition Property="Opacity" Duration="0:0:0.15" />
							</Transitions>
						</Border.Transitions>
					</Border>
				</Panel>
			</ControlTemplate>
		</Setter>

		<Style Selector="^[ResizeDirection=Rows] /template/ Border#PART_Lines">
			<Setter Property="BorderThickness" Value="0.0,1.0" />
		</Style>

		<Style Selector="^:pressed /template/ Border#PART_Lines">
			<Setter Property="BorderBrush" Value="{StaticResource MaterialPrimaryMidBrush}" />
		</Style>
	</ControlTheme>
</ResourceDictionary>
