<Styles
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:materialIcons="using:Material.Icons.Avalonia"
	xmlns:prop="using:Shared.Properties">

	<!-- Caption buttons of the title bar drawn by the application. -->
	<Style Selector="Button.CaptionButtonStyle,ToggleButton.CaptionButtonStyle">
		<Setter Property="Width" Value="{StaticResource CaptionButtonWidth}" />
		<Setter Property="Height" Value="{StaticResource TitleBarHeight}" />
		<Setter Property="Padding" Value="0.0" />
		<Setter Property="CornerRadius" Value="0.0" />
		<Setter Property="Cursor" Value="Arrow" />
		<Setter Property="Foreground" Value="{StaticResource MaterialBodyBrush}" />
		<Setter Property="Theme" Value="{StaticResource MaterialFlatButton}" />
	</Style>

	<Style Selector="ToggleButton.CaptionButtonStyle">
		<Setter Property="Content">
			<Template>
				<materialIcons:MaterialIcon
					Width="{StaticResource CaptionIconSize}"
					Height="{StaticResource CaptionIconSize}"
					Kind="WindowMaximize" />
			</Template>
		</Setter>

		<Setter Property="ToolTip.Tip" Value="{x:Static prop:Strings.Maximize}" />
	</Style>

	<Style Selector="ToggleButton.CaptionButtonStyle:checked">
		<Setter Property="Content">
			<Template>
				<materialIcons:MaterialIcon
					Width="{StaticResource CaptionIconSize}"
					Height="{StaticResource CaptionIconSize}"
					Kind="WindowRestore" />
			</Template>
		</Setter>

		<Setter Property="ToolTip.Tip" Value="{x:Static prop:Strings.Restore}" />
	</Style>

	<Style Selector="Button.CloseCaptionButtonStyle:pointerover">
		<Setter Property="Foreground" Value="{StaticResource CloseCaptionButtonBrush}" />
	</Style>
</Styles>
