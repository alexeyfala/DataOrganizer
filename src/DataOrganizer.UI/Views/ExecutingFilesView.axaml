<UserControl
	x:Class="DataOrganizer.UI.Views.ExecutingFilesView"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:windows="using:DataOrganizer.UI.ViewModels.Windows">

	<ListBox
		ItemTemplate="{StaticResource ExecutingFileTemplate}"
		ItemsSource="{Binding $parent[Window].((windows:EditorViewModel)DataContext).ExecutingFiles, Mode=OneTime}" />
</UserControl>
