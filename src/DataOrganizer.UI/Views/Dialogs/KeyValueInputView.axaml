<UserControl
	x:Class="DataOrganizer.UI.Views.Dialogs.KeyValueInputView"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:assists="using:Material.Styles.Assists"
	xmlns:clipboard="using:DataOrganizer.SystemIntegration.Clipboard.Interfaces"
	xmlns:controls="using:DataOrganizer.UI.Controls"
	xmlns:dialogs="using:DataOrganizer.UI.ViewModels.Dialogs"
	xmlns:input="using:DataOrganizer.UI.Behaviors.Input"
	xmlns:markup="using:DataOrganizer.UI.Markup"
	xmlns:security="using:DataOrganizer.UI.Behaviors.Security"
	x:DataType="dialogs:KeyValueInputViewModel"
	Theme="{StaticResource DialogTheme}">

	<UserControl.Styles>
		<Style Selector="TextBox.revealPasswordButton">
			<Setter Property="PasswordChar" Value="*" />
		</Style>
	</UserControl.Styles>

	<StackPanel
		MaxWidth="{StaticResource DialogMaxWidth}"
		Orientation="Vertical"
		Spacing="{StaticResource ElementSpacing}">

		<controls:SensitiveTextBlock
			x:Name="HeaderText"
			Classes="HeaderTextBlockStyle"
			IsSensitive="{Binding IsSensitive, Mode=OneWay}"
			IsVisible="{Binding Header, Converter={x:Static StringConverters.IsNotNullOrEmpty}, Mode=OneWay}"
			Text="{Binding Header, Mode=OneWay}"
			TextTrimming="CharacterEllipsis" />

		<controls:SecretTextBox
			assists:TextFieldAssist.Label="{Binding KeyHint, Mode=OneWay}"
			Classes.clearButton="{Binding !IsKeyMasked, Mode=OneWay}"
			Classes.revealPasswordButton="{Binding IsKeyMasked, Mode=OneWay}"
			Text="{Binding Key, Mode=TwoWay}"
			UseFloatingPlaceholder="True">
			<Interaction.Behaviors>
				<AutoFocusBehavior />

				<AutoSelectBehavior />

				<input:MoveFocusOnEnterBehavior
					IsMoveAllowed="{Binding IsKeyAccepted, Mode=OneWay}"
					Target="{Binding #ValueInput}" />

				<security:SensitiveCopyBehavior
					IsSensitive="{Binding IsSensitive, Mode=OneWay}"
					Writer="{markup:Resolve {x:Type clipboard:IClipboardTextWriter}}" />
			</Interaction.Behaviors>
		</controls:SecretTextBox>

		<controls:SecretTextBox
			x:Name="ValueInput"
			assists:TextFieldAssist.Label="{Binding ValueHint, Mode=OneWay}"
			Classes.clearButton="{Binding !IsValueMasked, Mode=OneWay}"
			Classes.revealPasswordButton="{Binding IsValueMasked, Mode=OneWay}"
			IsVisible="{Binding IsValueInputVisible, Mode=OneWay}"
			Text="{Binding Value, Mode=TwoWay}"
			UseFloatingPlaceholder="True">
			<Interaction.Behaviors>
				<security:SensitiveCopyBehavior
					IsSensitive="{Binding IsSensitive, Mode=OneWay}"
					Writer="{markup:Resolve {x:Type clipboard:IClipboardTextWriter}}" />
			</Interaction.Behaviors>
		</controls:SecretTextBox>

		<controls:DialogButtons
			HorizontalAlignment="Right"
			CancelCommand="{Binding CancelCommand}"
			Command="{Binding ConfirmCommand}"
			Text="{Binding DefaultButtonText, Mode=OneWay}" />
	</StackPanel>
</UserControl>
