<UserControl
	x:Class="DataOrganizer.UI.Views.Dialogs.ImportListSelectorView"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="using:DataOrganizer.UI.Controls"
	xmlns:dialogs="using:DataOrganizer.UI.ViewModels.Dialogs"
	xmlns:prop="using:DataOrganizer.Shared.Properties"
	x:DataType="dialogs:ImportListSelectorViewModel"
	Theme="{StaticResource DialogTheme}">

	<StackPanel
		Orientation="Vertical"
		Spacing="{StaticResource ElementSpacing}">
		<TextBlock
			Classes="HeaderTextBlockStyle"
			Text="{Binding Header, Mode=OneWay}" />

		<StackPanel
			Orientation="Vertical"
			Spacing="{StaticResource ElementSpacing}">
			<RadioButton
				Content="{x:Static prop:Strings.AddToEndOfList}"
				IsChecked="{Binding AddToList, Mode=TwoWay}" />

			<RadioButton
				Content="{x:Static prop:Strings.ReplaceTheList}"
				IsChecked="{Binding Replace, Mode=TwoWay}" />
		</StackPanel>

		<controls:DialogButtons
			HorizontalAlignment="Right"
			CancelCommand="{Binding CancelCommand}"
			Command="{Binding ApplyCommand}"
			Text="{x:Static prop:Strings.Select}" />
	</StackPanel>
</UserControl>
