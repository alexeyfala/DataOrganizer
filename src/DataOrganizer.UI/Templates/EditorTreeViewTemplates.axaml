<ResourceDictionary
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="using:DataOrganizer.UI.Controls"
	xmlns:converters="using:DataOrganizer.UI.Converters"
	xmlns:entities="using:DataOrganizer.Hierarchy.Dto"
	xmlns:input="using:DataOrganizer.UI.Behaviors.Input"
	xmlns:markup="using:DataOrganizer.UI.Markup"
	xmlns:materialIcons="using:Material.Icons.Avalonia"
	xmlns:nodes="using:DataOrganizer.UI.ViewModels.Hierarchy"
	xmlns:notes="using:DataOrganizer.Documents.Notes.Interfaces"
	xmlns:text="using:DataOrganizer.UI.Behaviors.Text"
	xmlns:views="using:DataOrganizer.UI.Views"
	xmlns:windows="using:DataOrganizer.UI.ViewModels.Windows">

	<!--  FolderInTreeViewRowTemplate  -->
	<DataTemplate
		x:Key="FolderInTreeViewRowTemplate"
		x:DataType="entities:FolderDto">
		<Grid
			Background="Transparent"
			Classes="CardFlyoutsStyle"
			ColumnDefinitions="Auto,*,Auto">

			<Grid.ContextFlyout>
				<controls:LazyMenuFlyout MenuTemplate="{StaticResource FolderInTreeViewContextMenuTemplate}" />
			</Grid.ContextFlyout>

			<Grid Grid.Column="0">
				<materialIcons:MaterialIcon Classes="FolderIconStyle" />

				<TextBlock
					HorizontalAlignment="Right"
					VerticalAlignment="Bottom"
					Text="{Binding Children.Count, Mode=OneWay}" />
			</Grid>

			<TextBlock
				Grid.Column="1"
				Classes="DtoNameTextBlockStyle"
				Text="{Binding Name, Mode=OneWay}">
				<Interaction.Behaviors>
					<text:MatchHighlightBehavior />

					<text:TextBlockAutoToolTipBehavior />
				</Interaction.Behaviors>
			</TextBlock>

			<views:IconsBlock
				Grid.Column="2"
				EncryptionStatus="{Binding EncryptionStatus, Mode=OneWay}"
				HasNote="{Binding Note, Mode=OneWay, Converter={x:Static ObjectConverters.IsNotNull}}"
				NoteItem="{Binding Mode=OneWay}"
				NoteName="{Binding Name, Mode=OneWay}"
				NoteReader="{markup:Resolve {x:Type notes:INoteReader}}" />
		</Grid>
	</DataTemplate>

	<!--  FileInTreeViewRowTemplate  -->
	<DataTemplate
		x:Key="FileInTreeViewRowTemplate"
		x:DataType="entities:FileDto">
		<Grid
			Background="Transparent"
			Classes="CardFlyoutsStyle"
			ColumnDefinitions="Auto,*">
			<Grid.ContextFlyout>
				<controls:LazyMenuFlyout MenuTemplate="{StaticResource FileInTreeViewContextMenuTemplate}" />
			</Grid.ContextFlyout>

			<Interaction.Behaviors>
				<input:ShowContextFlyoutOnDoubleTapBehavior />
			</Interaction.Behaviors>

			<materialIcons:MaterialIcon
				Grid.Column="0"
				Width="{StaticResource EntityKindIconSize}"
				Height="{StaticResource EntityKindIconSize}"
				Foreground="{StaticResource FileBrush}"
				Kind="{Binding Kind, Mode=OneWay, Converter={x:Static converters:ExplorerConverters.EntityKindToIconKind}}" />

			<ContentPresenter
				Grid.Column="1"
				Content="{Binding Mode=OneWay}"
				ContentTemplate="{StaticResource FileNameWithIconsTemplate}" />
		</Grid>
	</DataTemplate>

	<!--  RowCheckBoxTemplate  -->
	<DataTemplate
		x:Key="RowCheckBoxTemplate"
		x:DataType="nodes:ExplorerNodeViewModelBase">
		<!--  The work session keeps the check, so the box only shows it and asks the editor to toggle it.  -->
		<CheckBox
			AutomationProperties.Name="{Binding Model.Name, Mode=OneWay}"
			Classes="RowCheckBoxStyle"
			Command="{Binding $parent[Window].((windows:EditorViewModel)DataContext).ToggleCheckCommand, Mode=OneWay}"
			CommandParameter="{Binding Model, Mode=OneWay}"
			IsChecked="{Binding IsChecked, Mode=OneWay}" />
	</DataTemplate>

	<!--  FolderInTreeViewTemplate  -->
	<TreeDataTemplate
		x:Key="FolderInTreeViewTemplate"
		x:DataType="nodes:FolderNodeViewModel"
		ItemsSource="{Binding ShownChildren, DataType={x:Type nodes:ExplorerNodeViewModelBase}, Mode=OneTime}">
		<DockPanel>
			<!--  The hover circle of the check box reaches past the box, so the wrapper does not clip it.  -->
			<ContentControl
				ClipToBounds="False"
				Content="{Binding Mode=OneWay}"
				ContentTemplate="{StaticResource RowCheckBoxTemplate}"
				DockPanel.Dock="Left" />

			<!--  The row shows the folder itself, so its menu works with the folder.  -->
			<ContentControl
				Content="{Binding Model, Mode=OneWay}"
				ContentTemplate="{StaticResource FolderInTreeViewRowTemplate}" />
		</DockPanel>
	</TreeDataTemplate>

	<!--  FileInTreeViewTemplate  -->
	<DataTemplate
		x:Key="FileInTreeViewTemplate"
		x:DataType="nodes:FileNodeViewModel">
		<DockPanel>
			<!--  The hover circle of the check box reaches past the box, so the wrapper does not clip it.  -->
			<ContentControl
				ClipToBounds="False"
				Content="{Binding Mode=OneWay}"
				ContentTemplate="{StaticResource RowCheckBoxTemplate}"
				DockPanel.Dock="Left" />

			<!--  The row shows the file itself, so its menu works with the file.  -->
			<ContentControl
				Content="{Binding Model, Mode=OneWay}"
				ContentTemplate="{StaticResource FileInTreeViewRowTemplate}" />
		</DockPanel>
	</DataTemplate>
</ResourceDictionary>
