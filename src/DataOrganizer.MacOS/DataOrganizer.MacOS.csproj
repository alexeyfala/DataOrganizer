<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>$(AppTargetFramework)-macos</TargetFramework>
		<RuntimeIdentifier>osx-x64</RuntimeIdentifier>
		<SelfContained>true</SelfContained>
		<ApplicationIcon>$(AppIconPath)</ApplicationIcon>
		<ApplicationDisplayVersion>$(AppVersion)</ApplicationDisplayVersion>
		<ApplicationVersion>$(AppVersion)</ApplicationVersion>
		<!-- Replaces CFBundleDisplayName of Info.plist; the .app bundle takes this name too. -->
		<ApplicationTitle>$(AppName)</ApplicationTitle>
		<AssemblyName>$(AppName)</AssemblyName>
		<NullabilityInfoContextSupport>true</NullabilityInfoContextSupport>
		<SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia.Desktop" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\DataOrganizer.UI\DataOrganizer.UI.csproj" />
	</ItemGroup>

	<ItemGroup>
		<TrimmerRootDescriptor Include="Roots.xml" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="Logo.icns" />
	</ItemGroup>

	<!-- Ship license and attribution files inside the .app bundle (Contents/Resources). -->
	<ItemGroup>
		<BundleResource Include="..\..\LICENSE;..\..\NOTICE;..\..\THIRD-PARTY-NOTICES.txt" Link="%(Filename)%(Extension)" />
	</ItemGroup>

	<!-- Installer / disk-image naming (RuntimeIdentifier is fixed to osx-x64 above). -->
	<PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
		<_RidOs>$(RuntimeIdentifier.Substring(0, $(RuntimeIdentifier.IndexOf('-'))))</_RidOs>
		<_RidArch>$(RuntimeIdentifier.Substring($([MSBuild]::Add($(RuntimeIdentifier.LastIndexOf('-')), 1))))</_RidArch>
		<MacInstallerName>$(OutputBaseName)-$(_RidOs)-$(_RidArch)$(_DebugSuffix)</MacInstallerName>
	</PropertyGroup>

	<!--
		The localized names of the bundle, from AppDisplayName: the menu bar shows CFBundleName,
		Finder, the Dock and Spotlight show CFBundleDisplayName.
	-->
	<PropertyGroup>
		<CollectBundleResourcesDependsOn>$(CollectBundleResourcesDependsOn);WriteInfoPlistStrings</CollectBundleResourcesDependsOn>
	</PropertyGroup>

	<Target Name="WriteInfoPlistStrings">
		<WriteLinesToFile
			File="$(IntermediateOutputPath)InfoPlist.strings"
			Lines="CFBundleDisplayName = &quot;$(AppDisplayName)&quot;%3B;CFBundleName = &quot;$(AppDisplayName)&quot;%3B"
			Overwrite="true"
			WriteOnlyWhenDifferent="true" />

		<ItemGroup>
			<BundleResource Include="$(IntermediateOutputPath)InfoPlist.strings" LogicalName="en.lproj/InfoPlist.strings" />
		</ItemGroup>
	</Target>
</Project>
