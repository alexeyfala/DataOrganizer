<Project Sdk="Microsoft.NET.Sdk">
	<!--
		The Windows Installer hosts managed custom actions on .NET Framework, so this project targets it.
		Its tests compile its files themselves.
	-->
	<PropertyGroup>
		<AcceptEula>wix7</AcceptEula>
		<TargetFramework>net472</TargetFramework>
		<LangVersion>latest</LangVersion>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="PolySharp">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>$(DevelopmentDependencyAssets)</IncludeAssets>
		</PackageReference>
		<PackageReference Include="WixToolset.Dtf.CustomAction" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="CustomAction.config" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>
</Project>
