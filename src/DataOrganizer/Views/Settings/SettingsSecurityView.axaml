<UserControl
	x:Class="DataOrganizer.Views.Settings.SettingsSecurityView"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:converters="using:DataOrganizer.Converters"
	xmlns:dialogs="using:DataOrganizer.ViewModels.Dialogs"
	xmlns:prop="using:DataOrganizer.Shared.Properties"
	x:DataType="dialogs:SettingsViewModel">

	<HeaderedContentControl
		Classes="ClassicGroupBoxStyle"
		Header="{x:Static prop:Strings.AutoLock}">
		<StackPanel Orientation="Vertical">
			<ComboBox
				Height="{StaticResource SettingsComboBoxHeight}"
				AutomationProperties.Name="{x:Static prop:Strings.AutoLock}"
				ItemsSource="{Binding AutoLockDelays, Mode=OneTime}"
				SelectedItem="{Binding AutoLockMinutes, Mode=TwoWay}">
				<ComboBox.ItemTemplate>
					<DataTemplate>
						<TextBlock Text="{Binding Mode=OneWay, Converter={x:Static converters:SecurityConverters.AutoLockDelay}}" />
					</DataTemplate>
				</ComboBox.ItemTemplate>
			</ComboBox>

			<TextBlock
				Margin="10.0,4.0,0.0,0.0"
				Classes="SupportingTextBlockStyle"
				Text="{x:Static prop:Strings.AutoLockDescription}"
				TextWrapping="Wrap" />
		</StackPanel>
	</HeaderedContentControl>
</UserControl>
